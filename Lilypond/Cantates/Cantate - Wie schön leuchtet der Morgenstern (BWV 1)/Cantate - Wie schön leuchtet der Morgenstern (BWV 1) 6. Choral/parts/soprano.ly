PartPFiveVoiceOne =  \relative f' {
    \repeat volta 2 {
        \clef "treble" \time 4/4 \key f \major \partial 4 f4 
        c'4 a4 f4 c'4
        d4 d4 c4 ^\fermata c4
        d4 e4 f4 e4
          d4 d4 c4 ^\fermata a4
        d4 c4 bes4 a4
        g2 f4 ^\fermata } r4
    c'2 a2 ^\fermata
    c2 a2 ^\fermata
    a4 a4 g4 g4
    a4 a4 g4 a4
    bes4 a4 g2
    f2 ^\fermata f'4 e4
    d4 c4 bes4 a4
    g2 f4 ^\fermata \fine
    }

