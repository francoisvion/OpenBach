sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  a'4
          fis' e'8 d' a'4 a'
          b'2.\fermata b'4
          e' e' a' g'
          fis' e' d'\fermata a'
          b' b' a' g'
          fis'2.\fermata e'4
          fis' gis' a' b'8 cis''16 d''
          cis''4 b'8 a' a'4\fermata a'
          a' a' d'' c''
          b'2.\fermata b'4
          b' b' e'' d''
          cis''2.\fermata a'4
          b' a' b' cis''
          d''2.\fermata a'4
          a' g'8 fis' e' fis'16 g' e'4
          d'2.\fermata }
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  e'4
          d' cis' d' fis'
          g'2.\fermata e'4
          e'8 d' cis'4 d' e'
          e'8 d'4 cis'8 a4\fermata d'
          d' g' g'8 fis' e'4
          d'2.\fermata e'4
          d' d' cis' fis'
          e'2 e'4\fermata e'
          fis'8 e' fis' g' a'4 fis'
          g'2.\fermata a'4
          a' gis' gis'8 fis' fis' e'
