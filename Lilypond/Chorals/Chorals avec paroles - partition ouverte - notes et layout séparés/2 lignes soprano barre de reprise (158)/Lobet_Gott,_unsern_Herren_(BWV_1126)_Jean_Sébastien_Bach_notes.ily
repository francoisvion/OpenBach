sopranoMusic = {
  \repeat volta 2 {
    \partial 4 d'4
    f'4 e'4 f'4 g'4
    a'2 a'4\fermata c''4
    b'4 a'4 a'4 gis'4
    a'2.\fermata } a'4
  b'4 c''4 d''4 b'4
  c''2 a'4\fermata a'4
  g'4 f'4 f'4 e'4
  f'2\fermata r4 a'4
  f'4 g'4 a'4 g'4
  f'2 e'4\fermata f'4
  g'4 f'4 g'4 e'4
  d'2.\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial 4 a4
    d'4 e'4 d'4 d'4
    cis'2 cis'4\fermata e'4 ~
    e'8. d'16 c'!8 [d'16 e'16] f'4 e'4
    e'2.\fermata } e'4
  f'8 [e'8] e'8 [g'8] a'4 g'!4 ~
  g'8 f' g' [e'] f'4\fermata f'4~
  f'8 e' d'4 d'4 c'4
  c'2\fermata s4 e'4 ~
  e'8 d' c'4 ~ c'8 d' e'4
  e'8 [d'16 cis'16] d'4 d'8 [cis'8]\fermata d'4
  e'4 ~ e'8 d' e' [cis'16 b16] cis'4
  a2.\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial 4 f4
    a4 a4 a4 bes4
    e2 e4\fermata a4~
    a8 gis8 a8 [b16 c'16] d'8. [c'16] b8 [d'8]
    cis'2.\fermata } c'4
  d'4 c'8 [e'8] d'4 d'4
  c'2 c'4\fermata c'4
  c'8. [bes16] a4~a8 g~g16 a16 [bes8]
  a2\fermata r4 a4
  a4 c'8 [bes8] a8 [b8] c'8 [bes8]
  a2 a4\fermata a4
  bes4 a4 bes8 [g8] e8 [a16 g16]
  fis2.\fermata \fine
}

bassMusic = {
  \repeat volta 2 {        
    \partial 4 d4~
    d4. cis8 d8 c bes,4
    a,2 a,4\fermata a,4
    e4 f8 [e8] d8 [b,8] e4
    a,2.\fermata  } a4~
  a8 gis a [e] f [d] g [f]
  e8 [d8] e8 [c8] f4\fermata f,4
  c4 d8 [c8] bes,4 c4
  f,2\fermata s4 cis4
  d4 e4 f4 c4
  d8 [e8] f8 [d8] a4\fermata d4 ~
  d8 cis d [f,] g,4 a,
  d,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
   Lo -- bet Gott, un -- sern Her -- ren,
   in sei -- nem Hei -- lig -- thum,  
   Lobt Ihn im Fir -- ma -- men -- te,
   da sei -- ne groß' Ge -- walt
   und sein stark Re -- gi -- men -- te
   zu sehn ist man -- nig -- falt.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2    
   zu Lo -- be sei -- nen Eh -- ren,
   macht herr -- lich sei -- nen Ruhm.
}

altoLyricsOne = \lyricmode {\set stanza = 1
   Lo -- bet Gott, un -- sern Her -- ren,
