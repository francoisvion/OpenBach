sopranoMusic = {
\repeat volta 2 {
  g'2 a'4 b'2
  a'4 g' fis'
  e' d'2.\fermata
  g'2 a'4 b'2
  c''4 b' a'2
  g'2.\fermata }
  b'2 c''4 d''2
  c''4 b' a'2
  b'2.\fermata
  d''2 d''4 e''2
  d''4 c'' b'2
  a'2.\fermata
  b'4 c'' d'' c''2
  b'4 g'2
  a'4 b'2.
  g'\fermata b'4
  c'' d'' c''2
  b'4 a' b'2
  a'2. g'\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  d'2 d'4 d'2
  d'4 e' d'
  cis' a2.\fermata
  e'2 fis'4 g'2
  g'4 g'2
  fis'4 d'2.\fermata }
  g'2 g'4 fis'
  g' a' g'2
  fis'4 g'2.\fermata
  g'2 g'4 g'2
  fis'4 g' g'2
  fis'2.\fermata
  g'2 a'4 g'2
  fis'4 e'2
  e'4 e' dis'8 [cis'] dis'4
  e'2.\fermata d'!4
  e' f' e' fis'!
  g' fis' g'2~
  g'4 fis'8 [e'] fis'4 d'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  b2 fis4 g2
  a4 a a
  a fis2.\fermata
  b2 d'4 d'2
  c'4 d' e'
  d' b2.\fermata }
  d'2 e'4 a2
  d'4 d' e'
  d' d'2.\fermata
  b4 c' d' c'
  b a e' d'2
  d'2.\fermata
  d'2 d'4 g
  a b b2
  a4 g fis b
  b2.\fermata b2
  b4 c'2
  d'4 d'2 e'4
  a b c' b2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  g,4 b, d g2
  fis4 cis d
  a, d2.\fermata
  e2 d4 g
  fis e d c
  d g,2.\fermata }
  g4 fis e d
  e fis g c
  d g,2.\fermata
  g4 a b c'
  c d e8 [fis] g4
  g, d2.\fermata
  g2 fis4 e2
  dis4 e d
  c b,2.
  e\fermata g2
  g,4 a,2
  b,4 c b, c
  d2. g,\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Freu dich sehr, o mei -- ne See -- le,
  und ver -- giss all Not und Qual,
  Sei -- ne Freud und Herr -- lich -- keit
  sollt du sehn in E -- wig -- keit,
  mit __ _ den En -- geln ju -- bi -- lie -- ren,
  in __ _ E -- wig -- keit tri -- um -- phie -- ren.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  weil dich nun Chris -- tus, dein Her -- re,
  ruft aus die -- sem Jam -- mer -- tal!
}

