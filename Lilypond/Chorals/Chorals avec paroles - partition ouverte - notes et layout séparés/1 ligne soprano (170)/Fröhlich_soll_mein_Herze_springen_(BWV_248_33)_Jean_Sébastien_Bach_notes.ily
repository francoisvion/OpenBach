sopranoLyrics = \lyricmode {
  Ich will dich mit Fleiß be -- wah - ren,
  Ich will dir
  le -- ben hier,
  dir will ich ab -- fah -- ren,
  mit dir will ich end -- lich schwe - ben
  vol -- ler Freud
  oh -- ne Zeit
  dort im an -- dern Le -- ben.
}

