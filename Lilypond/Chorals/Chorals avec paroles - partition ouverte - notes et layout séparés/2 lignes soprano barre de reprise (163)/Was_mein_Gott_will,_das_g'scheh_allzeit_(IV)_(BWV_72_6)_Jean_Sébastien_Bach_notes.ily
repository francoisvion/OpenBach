sopranoMusic = {
\repeat volta 2 {
  \partial 4 e'8 [f']
  g'4 a' g' c''
  c'' b' c''\fermata c''
  b' a' d''4. c''8
  b'4 c'' b'2
  a'2.\fermata }
  a'4 a' a' b'8 [a']
  g'4 g' fis' g'\fermata
  g' a' b' c''
  b' a'2 b'4\fermata
  e'8 [f'] g'4 a' g'
  c'' c'' b' c''\fermata
  c'' b' a' d''4.
  c''8 b'4 c'' b'2
  a'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 c'4
  c' c' c' c'8 [d']
  e'4 d' e'\fermata e'
  d' d' d' a'
  gis' a'2 gis'4
  e'2.\fermata }
  e'4 d'8 e' fis'4~ fis'8 dis'
  e'4~ e' d' d'\fermata
  e' fis' gis' a'
  e'~ e' d'8 [e'16 f'] b4\fermata
  c'8 [d'] e'4 e'8 [d'] d' [c']
  g'4 f'8 [e'] f' [d'] e'4\fermata
  e' f'8 [e'] e' [d'] d'4
  e' e' a'2
  gis'4 e'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 a4
  g f e8 [f] g [a]
  g4 g g\fermata g
  g f8 [g] a [b] c' [d']
  e'2~ e'8 [b e' d']
  c'2.\fermata }
  c'8 [b] a4 d'8 [c'] b4
  b a a b\fermata
  c'8 [b] a4 d' e'8 [f']
  g'4 c' b8 [a] gis4\fermata
  a b a e'
  e' a g g\fermata
  a a8 [gis] a4 gis8 [a]
  b [a] gis4 fis b8 [c']
  d'4 cis'2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 a4
  e f c8 [d] e [f]
  g4 g, c\fermata c
  g d8 [e] fis [gis] a4
  e8 [d c d] e2
  a,2.\fermata }
  a8 [g] fis [e] d4 g8 [fis]
  e [d] cis4 d g,\fermata
  cis c' b a
  g f2 e4\fermata
  a g f e
  d8 [c] d4 g c\fermata
  a, d8 [e] f4 b,8 [a]
  gis [a] d4 dis e2
  a,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Was mein Gott will, das g'scheh all -- zeit,
  sein Will, der ist der bes -- _ _ te,
  Er hilft aus Not, der from -- me Gott,
  und züch -- ti -- get mit Ma -- ßen.
  Wer Gott ver -- traut, fest auf ihn baut,
  den will er nicht ver -- las -- _ _ sen.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  zu hel -- fen den'n er ist be -- reit,
  die an ihn glau -- ben fes -- _ _ te.
}

