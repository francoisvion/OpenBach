sopranoMusic = {
\repeat volta 2 {
  \partial 4 e'8 [fis']
  gis'4 a' b' b'
  a' gis' fis'\fermata b'
  cis'' dis'' e'' dis''8 [cis'']
  cis''2 b'4\fermata }
  b' e'' dis'' cis''
  b' a' gis' fis'\fermata
  b' a' gis' fis'8 [gis']
  a'4 gis' fis' e'\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 b4
  e' e'8 [dis'] e'4 e'
  b b8 [cis'] dis'4\fermata fis'
  fis' fis' e'8 [fis'] gis'4
  fis'4. e'8 dis'4\fermata }
  e'8 [fis'] gis'4 a'8 [b'] e'4
  fis'8 [gis'] cis' [dis'] e'4 dis'\fermata
  gis'8 [fis'] e'4 e' e'8 [dis']
  e'4 e' dis' b\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 gis8 [a]
  b4 a gis gis
  fis gis8 [a] b4\fermata dis'
  cis' ais b b
  b ais b\fermata }
  gis cis' cis'8 [b] a4
  a8 [gis] a4 b8 [cis'] dis'4\fermata
  dis' cis' b cis'8 [b]
  a4 b4. a8 gis4\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 e,4
  e fis gis cis
  dis e b,\fermata b
  ais gis8 [fis] gis4 fis8 [e]
  fis4 fis, b,\fermata }
  e8 [dis] cis4 fis8 [gis] a4
  dis8 [eis] fis4 gis8 [ais] b4\fermata
  gis cis8 [dis] e4 a,8 [b,]
  cis4 b,8 [a,] b,4 e,\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Da -- he -- ro Trotz der Höl -- len Heer!
  Trotz auch des To -- des Ra -- chen!
  Gott ist mein Schutz, mein Hilf und Rat;
  Wohl dem, der Gott zum Freun -- de hat!
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Trotz al -- ler Welt! mich kann nicht mehr
  ihr Po -- chen trau -- rig ma -- chen!
}

