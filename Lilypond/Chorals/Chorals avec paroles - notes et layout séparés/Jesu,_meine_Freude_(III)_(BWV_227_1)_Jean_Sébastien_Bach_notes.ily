sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          b'4 b' a' g'
          fis'2 e'\fermata
          b'4 cis'' d'' b'
          e''2 dis''\fermata
          e''8 [fis''] g''4 fis''4. fis''8
          e''1\fermata }          
          b'4 b' c'' b'
          a'4. a'8 g'2\fermata
          b'4 cis'' d'' b'
          e'' d''8 [cis''] cis''2
          b'\fermata b'4 b'
          a' g'8 [fis'] fis'2
          e'1\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          g'4 fis' e'8 [dis'] e'4
          e' dis' b2\fermata
          g'8 [fis'] e'4 d' d'
          g'8 [a'] b'4 b'2\fermata
          g'8 [a'] b'4 b'4. a'8
          g'1\fermata }          
          g'4 g' a' g'
          g' fis' d'2\fermata
          g'4 g' a' g'8 [a']
          b'4 b' b' ais'
          fis'2\fermata g'4 fis'
          e' e' e' dis'
          b1\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          e'4 b c'8 [fis] g4
          c' b8 [a] g2\fermata
          e'8 [d'] cis' [b] a4 g8 [a]
          b4 g' fis'2\fermata
          e'4 e' e' dis'
          b1\fermata }        
          e'4 d' d' d'
          e' d'8 [c'] b2\fermata
          d'4 e' d' d'
          g' fis' g' fis'8 [e']
          dis'2\fermata e'4 fis'8 [g']
          a' [a] b4 c' b8 [a]
          gis1\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          e4 d c4. b,8
          a,4 b, e2\fermata
          e4 a8 [g] fis4 g8 [fis]
          e [fis] g [a] b2\fermata
          c'4 b8 [a] b4 b,
          e1\fermata }
          e8 [fis] g4 fis g
          c d g,2\fermata
          g4 fis8 [e] fis4 g8 [fis]
          e4 b, e fis
          b,2\fermata e4 d
          c b, a, b,
          e1\fermata \fine
        }

versoOneLyrics = \lyricmode {\set stanza = 1
      Je -- su, mei -- ne Freu -- de,
      mei -- nes Her -- zens Wei -- de,
      Je -- su, mei -- ne Zier!
      Got -- tes Lamm, mein Bräu -- ti -- gam,
      Au -- ßer dir soll mir auf Er -- den
      nichts sonst Lie -- bers wer -- den.
    }

versoTwoLyrics = \lyricmode {\set stanza = 2
      ach wie lang, ach lan -- ge
      ist dem Her -- zen ban -- ge
      und ver -- langt nach dir! 
    }
