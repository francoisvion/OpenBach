sopranoMusic = {
  \repeat volta 2 {
    \partial 4  d'4
    a' a' b' cis''
    d''2 d''4\fermata fis''
    e'' d'' d'' cis''
    d''2.\fermata } d''8 [e'']
  fis''4 fis'' e''4. d''8
  cis'' [b'] cis''4 a'\fermata cis''
  d'' cis'' b' b'
  a'2.\fermata a'4
  fis'8 [g'] a'4 b' a'
  a' g'8 [fis'] fis'4\fermata a'
  g' fis' e' e'
  d'2.\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial 4  a4
    d' d' d' g'
    g' fis'8 [e'] fis'4\fermata a'8 [b']
    cis''4 b' b' a'
    a'2.\fermata } a'4
  d'' d''8 [cis''] b' [gis'] a' [b']
  e' [fis'] gis'4 fis'\fermata a'
  a'8 [gis'] a'4 a' gis'
  e'2.\fermata e'4
  d' d' d'8 [e'] fis'4
  fis' e' dis'\fermata d'
  d' d' d' cis'
  a2.\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial 4  fis8 [e]
    fis [g] a [fis] g4 g8 [a]
    b4 a8 [g] a4\fermata a'
    g' fis' f' e'
    fis'2.\fermata } fis'8 [g']
  a'4 d' e'8 [d'] cis' [b]
  a4 gis cis'\fermata fis'8 [e']
  d'4 e' e'8 [fis'] e' [d']
  cis'2.\fermata a4
  a d'8 [c'] b [cis'] d' [c']
  b2 b4\fermata c'
  b b b a8 [g]
  fis2.\fermata \fine
}

bassMusic = {
  \repeat volta 2 {
    \partial 4  d8 [cis]
    d [e] fis [d] g [fis] e4
    b,8 [cis] d4 d,\fermata d'
    ais b8 [a] gis4 a
    d2.\fermata } d4
  d'8 [cis'] b [a] gis [e] fis [gis]
  a [gis] fis [eis] fis4\fermata fis
  b8 [b,] cis [d] e! [d] e [e,]
  a,2.\fermata cis4
  d8 [e] fis [d] g4 fis8 [e]
  dis4 e b,\fermata fis,
  g,8 [a,] b, [a,] g, [e,] a,4
  d,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
   Va -- let will ich dir ge -- ben,
   du ar -- ge, fal -- sche Welt,
   Im Him -- mel ist gut woh -- _ nen,
   hin -- auf steht mein Be -- gier,
   da wird Gott herr -- lich loh -- _ nen
   dem, der ihm dient all -- hier.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
   Dein sünd -- lich bö -- ses Le -- ben
   Durch -- aus mir nicht ge -- fällt.
}

