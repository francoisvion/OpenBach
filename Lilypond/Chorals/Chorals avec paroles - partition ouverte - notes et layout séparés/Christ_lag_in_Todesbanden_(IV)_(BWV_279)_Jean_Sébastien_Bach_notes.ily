sopranoMusic = {
  \repeat volta 2 {
    \partial 4 b'4
    ais' b'8 [cis''] d''4 e''
    d'' cis'' b'\fermata b'
    g' a' b' a'8 [g']
    fis'2 e'4\fermata } r e' g' a' e'
  g' a' b'\fermata b'
  e'' dis'' e'' fis''
  d'' cis'' b'\fermata b'8 [c'']
  d''4 b' d'' a'
  g' fis' e'2\fermata
  b'4 a' g' fis'
  e'2.\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial 4 g'4
    fis' fis'8 [ais'] b'4 cis''
    b' ais' fis'\fermata fis'
    e' d' d' e'
    e' dis' b\fermata } r b e'8 [d'] e'4 c'
  b a g\fermata d'
  g' fis' e' b'
  b' ais' fis'\fermata g'
  a' d' d' c'
  b8 e'4 d'8 d'4 c'\fermata
  b8 [cis'] dis'4 e'8 [c''] dis'4
  b2.\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial 4 e'8 [d']
    cis'4 d'8 [e'] fis'4 fis'
    fis' fis'8 [e'] dis'4\fermata b
    b a g8 [a] b4
    c' b8 [a] g4\fermata } r g g c' a
  g d' d'\fermata b
  b a b b
  fis' fis'8 [e'] d'4\fermata b
  a g g fis
  g a a2\fermata
  fis g8 [e] b [a]
  gis2.\fermata \fine
}

bassMusic = {
  \repeat volta 2 {
    \partial 4 e4
    fis8 [e] d [cis] b,4 ais,
    b, fis b,\fermata dis
    e fis g e
    a, b, e\fermata } r e8 [d] c [b,] a, [b,] c [d]
  e4 fis g\fermata g
  e fis g d8 [e]
  fis4 fis, b,\fermata e
  fis g b,8 [c] d4
  e fis8. [gis16] a2\fermata
  dis4 b, e8 [a,] b,4
  e2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Christ lag in To -- des -- ban -- _ den
  für un -- ser Sünd' ge -- ge -- ben,
  Dess wir sol -- len fröh -- lich sein,
  Gott lo -- ben und ihm dank -- bar sein,
  und sin -- gen Hal -- le -- lu -- _ ja,
  Hal -- le -- lu -- _ ja!
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  der ist wie -- der er -- stan -- _ den
  und hat uns bracht das Le -- ben.
}

