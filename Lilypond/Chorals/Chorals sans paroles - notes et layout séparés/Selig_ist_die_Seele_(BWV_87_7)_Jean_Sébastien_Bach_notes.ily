sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          a'4 a' g' f'
          e'2 d'\fermata
          a'4 a' b' cis''
          d''2 cis''\fermata
          d''8 e'' f''4 e'' e''
          d''1\fermata }
          a'4 a' bes' a'
          g'8 a'16 bes' g'4 f'2\fermata
          a'4 b' c'' a'
          d'' c''8 b' b'2
          a'\fermata a'4 d''
          g' f'8 e' e'2
          d'1\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          f'4 f' e' d'
          d' cis' a2\fermata
          f'4 f' f'8 d' g'4
          a' g' a'2\fermata
          a'4 a' bes' a'8 g'
          f'1\fermata }
          f'8 g' a'4 a'8 g' f'4
          f' e' c'2\fermata
          f'4 f' g' e'
          a'8 e' e' f' e' f' e' d'
          cis'2\fermata d'4 d'
          d'8 cis' d'4 d'8 cis'16 b cis'4
          a1\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          d'4 d' d'8 cis' d'4
          a8 bes a g f2\fermata
          d'4 d' d'8 b e'4
          d'8 e'16 f' e'8 d' e'2\fermata
          a4 d' d' cis'
          a1\fermata }
          d'4 d' d' c'
          c'8 a bes g a2\fermata
          c'4 d' e' cis'
          a8 b c' a a4 gis
          a2\fermata f8 g a f
          g4 a8 bes a e a g
          fis1\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          d8 e f d bes4 a8 g
          a4 a, d2\fermata
          d8 e f d g4 f8 e
          f g16 a bes4 a2\fermata
          f8 e d f g e a a,
          d1\fermata }
          d8 e f d g4 a8 bes
          c'4 c f2\fermata
          f8 e d f e f g e
          fis gis a d e4 e,
          a,2\fermata d8 e f d
          bes4 a8 g a4 a,
          d1\fermata \fine
        }
