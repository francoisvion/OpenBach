sopranoLyrics = \lyricmode {
      Chris -- te, der du bist Tag und Licht,
      Vor dir ist, Herr, ver -- bor -- gen nichts;
      du vä -- ter -- li -- ches Lich -- tes Glanz,
      Lehr' uns den Weg der Wahr -- heit ganz.
    }

