sopranoMusic = {
\repeat volta 2 {
  a'4 bes' c'' c''
  bes' a' g' g'\fermata
  a' bes' c''8 [bes'] a'4
  g'8 [a'16 bes'] g'4 f'2\fermata }
  \partial 4 g'4
  a' bes' bes' a'4.
  g'8 g'2\fermata bes'4
  c'' d'' d'' c''8 [d''16 ees'']
  c''4 bes'2\fermata a'4
  bes' c'' c'' bes'
  a' g' g'\fermata a'
  bes' c'' f'8 [g'] a'4
  g' f'2\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  f'4 f' f' f'8 [e']
  d' [e'] f'4 e' e'\fermata
  f' f' g' f'
  f' e' c'2\fermata }
  \partial 4 e'4
  fis' g' g' g'
  fis' d'2\fermata d'4
  ees' f'8 [ees'] f' [d'] g'4
  f'8 [ees'] d'2\fermata c'4
  bes a8 [g'] f' [e'] d' [e']
  f'4 e' e'\fermata f'
  f' f'8 [e'] f'4 f'
  e' c'2\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  c'4 d' c'8 [bes] a4
  bes c' c' c'\fermata
  c' d' c' c'
  d' c'8 [bes] a2\fermata }
  \partial 4 c'4
  c' d' bes ees'
  d'8 [c'] bes2\fermata bes4
  a8 [g] f4 bes bes
  a f2\fermata f8 [f']
  e' [d'] c' [bes] a4 bes
  c' c' c'\fermata c'
  d' c'8 [bes] c' [d'] c'4
  c'8 [bes] a2\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  f4 d a, d
  g, a,8 [bes,] c4 c\fermata
  f e8 [d] e4 f
  bes, c f,2\fermata }
  \partial 4 c4
  bes,8 [a,] g, [bes,] ees [d] c [a,]
  d4 g,2\fermata g4
  f8 [ees] d [c] bes,4 ees
  f bes,2\fermata f4
  g a d g
  a8 [bes] c'4 c\fermata f8 [d]
  c [bes,] a, [g,] a, [bes,] c4
  c f,2\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Freu dich sehr, o mei -- ne See -- le,
  und ver -- giß all Not und Qual,
  Aus Trüb -- sal und gro -- ßem Leid
  sollst du fah -- ren in die Freud,
  die kein Oh -- re hat ge -- hö -- ret
  und in E -- wig -- keit auch währt.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  weil dich nun Chris tus, -- dein Her -- re,
  ruft aus -- die sem Jam mer tal.
}

