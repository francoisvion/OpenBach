sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  fis'4
          b' cis'' d'' cis''
          b' cis'' ais'2
          fis'4\fermata a' a' g'
          fis' b' b' ais'
          b'2.\fermata }  cis''4
          d'' e'' fis''8 e'' fis'' g''
          e''4 e'' d''\fermata fis''
          e'' d'' cis'' b'8 cis''
          d'' e'' cis''4 b'\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  d'8 e'
          fis'4 fis' fis'8 g' a'4
          g' g' fis'2
          cis'4\fermata cis'8 d' e'4 e'
          fis'8 e' d'4 cis'8 d' e'4
          d'2.\fermata } fis'4
          fis'8 b' a' g' fis'4 b'
          b' a'8 g' fis'4\fermata a'
          ais' b' e'8 dis' e'4
          fis'8 g' fis' e' dis'4\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  b8 cis'
          d'4 cis' b cis'8 d'
          e'4 e'8 d' cis'2
          ais4\fermata a a8 b cis'4
          cis' b8 a g4 fis
          fis2.\fermata } ais4
          b8 g' fis' e' d'4 d'
          d'8 b cis'4 a\fermata a8 b
          cis'4 fis8 g a fis b4
          b ais fis\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  b,4
          b ais b fis
          g8 fis e4 fis2
          fis,4\fermata fis cis b,8 a,
          d4 g8 fis e4 fis
          b,2.\fermata } fis4
          b cis' d'8 cis' b a
          g4 a d\fermata d
          cis b, a, g,8 g
          fis e fis4 b,\fermata \fine
        }
