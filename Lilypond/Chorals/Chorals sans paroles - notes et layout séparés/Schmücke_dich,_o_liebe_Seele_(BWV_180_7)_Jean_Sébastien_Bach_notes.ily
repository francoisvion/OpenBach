sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          a'4 g' f' g'
          a'8 [bes'] c''4 bes'2
          a'\fermata c''4 a'
          bes' a'8 [g'] f' [g'] a'4
          g'2 f'\fermata }
          c''4 d''8 [e''] f''4 f''
          e''8 [d''] c'' [d''] d''2
          c''\fermata c''4 d''8 [e'']
          f''4 f'' e''8 [d''] c'' [d'']
          d''2 c''\fermata
          g'4 a' bes' bes'
          a'8 [c''] bes' [a'] g'4 g'\fermata
          c'' a' bes' a'8 [g']
          f' [g'] a'4 g'2
          f'1\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          f'4 e' d' c'
          c' f'2 e'4
          f'2\fermata g'4 f'
          f' f'8 [e'] d' [e'] f'4~
          f' e' c'2\fermata }
          a'4 g' f'8 [g'] a'4
          a' e' a' g'8 [f']
          e'2\fermata f'4 f'8 [g']
          a'4 a' g' g'8 [a']
          g' [f'16 e'] f'4 e'2\fermata
          e'4 f' e'8 [f'] g'4
          f'8 [a'] g' [f'] e'4 e'\fermata
          e' f'4. e'8 f' [e']
          d' [e'] f'2 e'4
          c'1\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          c'4 c'8 [bes] a4 g
          f8 [g] a4 g8 [f] g4
          f2\fermata c'4 c'
          d' c' d' c'
          c'8 [bes16 a] bes4 a2\fermata }
          f'4 b8 [cis'] d'4 d'
          c'8 [b] c'2 b4
          c'2\fermata a4 bes
          c'8 [b] c' [d'] e' [f'] g' [c']
          c'4 b c'2\fermata
          c'4 c' bes8 [a] g4
          c' d' e'8 [d'] c'4\fermata
          c' c' bes c'
          d' c' c'8 [bes16 a] bes4
          a1\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          f4 c d e
          f a,8 [bes,] c2
          f,\fermata e4 f
          d8 [e] f4 bes, a,8 [bes,]
          c2 f,\fermata }
          f4 e d8 [e] f [g]
          a4. g8 f4 g
          c2\fermata f4 bes,
          a,8 [g,] a, [b,] c [d] e [f]
          g4 g, c2\fermata
          c'4 bes8 [a] g4 f8 [e]
          f4 bes, c c\fermata
          a, d g, a,
          bes, a,8 [bes,] c2
          f,1\fermata \fine
        }


