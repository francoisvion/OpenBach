sopranoLyrics = \lyricmode {
      Was frag' ich nach der Welt,
      und al -- len ih -- ren Schä -- tzen,
      wenn ich mich nur an dir,
      mein Je -- su, kann er -- gö -- tzen?
      Dich hab' ich ein -- zig mir
      zur Wol -- lust vor -- ge -- stellt:
      Du, du bist mei -- ne Lust:
      was frag' ich nach der Welt!
    }
