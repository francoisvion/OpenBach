sopranoMusic = {
\repeat volta 2 {
  \partial 4 f'4
  c'' a' f' c''
  d'' d'' c''\fermata c''
  d'' e'' f'' e''
  d'' d'' c''\fermata a'
  d'' c'' bes' a'
  g'2 f'4\fermata } r
  c''2 a'\fermata
  c'' a'\fermata
  a'4 a' g' g'
  a' a' g' a'
  bes' a' g'2
  f'\fermata f''4 e''
  d'' c'' bes' a'
  g'2 f'4\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 c'4
  c' c' d' f'
  bes' bes' a'\fermata a'
  bes' bes' c''8 [d''] c'' [g']
  a'4 g' g'\fermata f'
  f' e' f'8 [g'] c' [f']
  f'4 e' c'\fermata } r
  g'2 f'\fermata
  f'8 [e'16 d'] e'4 f'2\fermata
  f'4 f' e' e'
  f' f' e' f'
  g' f'8 [e'] d'4 e'
  f'2\fermata a'4 a'8 [g']
  f'4 f' f'8 [e'] c' [f']
  f'4 e' c'\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 a4
  g a a a
  f f' f'\fermata f'
  f' g' f'8 [d'] e'4
  f'8 [e'] d'4 e'\fermata c'8 [a]
  f [g] a4 a8 [g] a [f]
  g [a] bes4 a\fermata } r
  c'2 c'\fermata
  c' c'\fermata
  c'4 c' c' c'
  c' c' c' c'
  d' d' d' c'
  c'2\fermata d'4 c'
  d'8 [bes] f [a] bes4 c'8 [a]
  d'4 g16 [f g8] a4\fermata  \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 f4
  e f d a,
  bes,8 [c] d [e] f4\fermata f
  bes a8 [g] a [b] c'4
  f g c\fermata f
  bes, c d8 [e] f4
  c2 f,4\fermata } r
  e2 f\fermata
  c f\fermata
  f8 [g] a [f] c [d] e [c]
  f [g] a [f] c'4 bes8 [a]
  g4 d'8 [c'] bes4 c'
  f2\fermata d8 [f] a4
  bes,8 [d] f4 g a8 [d]
  b,4 c f,\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Wie bin ich doch so herz -- lich froh,
  dass mein Schatz ist das A und O,
  der An -- fange und das En -- de;
  A -- men!
  A -- men!
  Komm, du schö -- ne Freu -- den -- kro -- ne, bleib nicht lan -- ge,
  dei -- ner wart ich mit Ver -- lan -- gen.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Er wird mich doch zu sei -- nem Preis
  auf neh men in das Pa ra deis,
  des klopf -- ich in die Hän -- de.
}

