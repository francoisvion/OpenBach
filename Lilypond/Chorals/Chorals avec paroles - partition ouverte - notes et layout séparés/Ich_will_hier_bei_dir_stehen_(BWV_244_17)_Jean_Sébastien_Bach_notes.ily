sopranoMusic = {
\repeat volta 2 {
  \partial 4 g'4
  c'' bes' aes' g'
  f'2 g'4\fermata d''
  ees'' ees'' d''8 [c''] d''4
  c''2.\fermata }
  ees''4 d''8 [c''] bes'4 c''
  d'' ees''2 ees''4\fermata
  bes' c'' bes' aes'
  aes' g'2.\fermata
  ees''4 d''8 [ees''] f''4 ees''
  d'' c''2 d''4\fermata
  g' aes' g' f'
  bes' g'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 ees'4
  ees' ees' ees'8 [f'] f' [ees']
  ees'4 d' ees'\fermata f'
  ees'8 [f'] g'4 g' g'8 [f']
  ees'2.\fermata }
  c''8 [bes'] aes'4 g'8 [f'] ees'4
  aes' aes' g'8 [f'] g'4\fermata
  g' aes' g' g'
  f' e'2.\fermata
  f'4 f' f' g'
  f' g' f' f'\fermata
  ees' ees'8 [d'] ees'4 ees'
  d' ees'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 bes4
  aes bes c'8 [bes] bes4
  c' bes bes\fermata b
  g c' c' b
  c'2.\fermata }
  g'4 f'8 [ees'] d'4 c'8 [bes]
  aes [bes] c'4 bes8 [aes] bes4\fermata
  ees' ees' ees'8 [d'] c'4
  c' c'2.\fermata
  c'4 bes bes8 [a] bes [c']
  d' [bes] g [c'] a4 bes\fermata
  bes aes bes c'
  f8 [bes] bes2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 ees4
  aes g c8 [d] ees4
  aes, bes, ees\fermata d
  c8 [d] ees [f] g4 g,
  c2.\fermata }
  c'4 f g aes8 [g]
  f4 ees2 ees4\fermata
  ees aes ees f8 [g]
  aes [bes] c'2.\fermata
  aes4 bes d g8 [a]
  bes4 ees f bes,\fermata
  ees8 [d] c4 bes, aes,
  bes, ees2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Ich will hier bei dir ste -- hen;
  ver -- ach -- te mich doch nicht,
  Wenn dein Herz wird er -- blas -- sen
  im letz -- ten To -- des -- stoß,
  als -- denn will ich dich fas -- sen
  in mei -- nen Arm und Schoß.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Von dir will ich nicht ge -- hen,
  wenn dir dein Her -- ze bricht,
}

