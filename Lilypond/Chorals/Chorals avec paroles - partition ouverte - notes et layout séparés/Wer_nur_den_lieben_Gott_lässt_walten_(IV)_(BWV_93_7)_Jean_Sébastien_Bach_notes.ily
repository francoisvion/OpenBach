sopranoMusic = {
\repeat volta 2 {
  \partial 4 g'4
  c'' d'' ees'' d''
  c'' d'' bes' g'\fermata
  r bes' bes' aes'
  g' c'' c''8 [d''] b'4
  c''2.\fermata }
  d''4 ees'' f'' g''
  g'' f'' f'' ees''2\fermata
  r4 g'' f''
  ees'' d'' c''8 [d''] ees''4
  d'' c''2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 ees'4
  g' g' g' g'8 [f']
  ees'4 aes' g' d'\fermata
  r g' g' f'
  ees' g' g' g'
  g'2.\fermata }
  g'4 g' bes' bes'
  bes' c'' bes'8 [aes'] g'2\fermata
  r4 bes' aes'
  a' b' c'' c''
  g'8 [f'] e'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 c'4
  ees' d' c' b
  c' f' d' b\fermata
  r d' ees' f'8 [bes]
  bes4 c'8 [d'] ees'4 d'
  ees'2.\fermata }
  b4 c' d' ees'
  ees' ees' d' bes2\fermata
  r4 ees' ees'8 [d']
  c' [a] d' [ees'16 f'] ees'4 a8 [b16 c']
  b4 g2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 c4
  c' b c' g
  aes f g g,\fermata
  r g c d
  ees4. f8 g4 g,
  c2.\fermata }
  g4 c' bes8 [aes] g4
  f8 [ees] aes4 bes ees2\fermata
  r4 ees f
  fis g aes8 [g] fis4
  g c2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Sing, bet und geh auf Got -- tes We -- gen,
  ver -- richt das Dei -- ne nur ge -- treu
  denn wel -- cher sei -- ne Zu -- ver -- sicht
  auf Gott setzt, den ver -- lässt er nicht.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  und trau des Him -- mels rei -- chem Se -- gen,
  so wird er bei dir wer -- den neu;
}

