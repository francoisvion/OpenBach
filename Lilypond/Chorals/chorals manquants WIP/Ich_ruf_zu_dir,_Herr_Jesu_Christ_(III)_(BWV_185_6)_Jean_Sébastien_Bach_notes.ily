sopranoMusic = {
\repeat volta 2 {
  \partial 4 cis''8 [b']
  a'4 b' a'8 [gis'] fis' [gis']
  a' [b'] b'8. a'32 [b'] cis''4\fermata cis''8 [d'']
  e'' [d''] cis'' [b'] a'4 b'8 [cis'']
  d''2 cis''4\fermata }
  e'' fis'' e''8 [d''] cis'' [b']
  a' [b'] cis'' [d''16 e''] b'4 a'\fermata
  cis'' cis'' cis'' b'
  a' gis' fis'\fermata a'
  gis' fis'2 e'4\fermata
  e' a' a' b'
  b' cis'' d'' cis''4.
  b'8 a' [gis'] fis' [gis'] a'4
  gis' fis'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 gis'4
  a' gis' fis' cis''8 [b']
  a' [gis'] fis'4 gis'\fermata a'
  gis'8 [fis'] e'4 fis'4. e'8
  d' [e' fis' gis'] a'4\fermata }
  a'8 [gis'] fis'4 gis' a'8 [fis']
  e' [d'] cis' [b16 a] e'4 e'\fermata
  e' fis' fis'8 [e'] d'4
  cis' cis' cis'\fermata r8 fis'4
  e'8~ e' dis'16 [cis'] dis'4 e'\fermata
  e' e' a'8 [gis'] fis'4
  e' e' d' e'8 [fis']
  gis'4 cis'4. b8 a [b]
  cis'4 cis'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 cis'4
  cis' cis' cis'8 [b] a [gis]
  fis4 fis cis'\fermata a
  b cis' d'8 [cis'] d' [e']
  fis' [e' d'] cis'16 [b] cis'4\fermata }
  cis'8 [b] a4 e' e'8 [d']
  cis' [b] a4 b cis'\fermata
  cis'8 [b] a4 a gis
  a b a\fermata fis
  gis8 [a] b2 b4\fermata
  b cis' cis' b
  e'8 [d'] cis'4 b a
  gis a8 [b] cis' [d'] cis'4.
  b8 ais2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 eis4
  fis cis fis, fis
  e d cis\fermata fis
  gis a d cis
  b,2 fis,4\fermata }
  cis d e a,8 [b,]
  cis [d] e4 e, a,\fermata
  a8 [gis] fis [e] dis4 eis
  fis cis fis,\fermata dis
  e b,2 e,4\fermata
  e8 [d] cis [b,] a,4 d
  e ais, b, cis8 [dis]
  eis4 fis8 [gis] a [b] cis'4
  cis fis,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Ich ruf zu dir, Herr Je -- su __ Christ,
  ich bitt, er -- hör mein Kla -- gen,
  den rech -- ten Glau -- ben, Herr, ich mein,
  den wol -- lest du mir ge -- ben,
  dir zu le -- ben,
  meinm Näch -- sten nütz zu sein, dein Wort zu hal -- ten e -- _ ben.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  ver -- leih mir Gnad zu die -- ser __ Frist,
  lass mich doch nicht ver -- za -- gen;
}

