sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  e'4
          a' b' c'' b'
          a' b' gis'4. fis'8
          e'4\fermata g' g' f'
          e' a' a'8 [b'] gis'4
          a'2.\fermata } b'4
          c'' d'' e'' e''
          d''8 [e''16 f''] d''4 c''\fermata e''
          d'' c'' b' a'8 [b']
          c'' [b'] b'4 a'\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  c'8 [d']
          e'4 e' e'8 [fis'] gis'4
          a'8 [g'] f'4 e'2
          b4\fermata e' e' d'
          d'8 [cis'] d' [dis'] e' [fis'] e'4
          e'2.\fermata } gis'4
          a' g' g' a'
          a' g'8 [f'] e'4\fermata e'
          fis'8 [gis'] a'4 g'8 [f'] e'4
          fis' e'8 [d'] cis'4\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  a8 [b]
          c' [b] a [gis] a4 d
          e8 [e'] d' [c'] b4. a8
          gis4\fermata b c' d'8 [c']
          b [a] a [b] c' b4 c'16 [d']
          c'2.\fermata } e'4
          e' d' c' c'
          c' b g\fermata a
          a8 [e'] e' [ees'] d'4 c'8 [b]
          a4 gis e\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  a4
          c e a, b,
          c d e2
          e4\fermata e a b8 [a]
          gis [g] fis [f] e [dis] e4
          a,2.\fermata } e4
          a b c'8 [b] a [g]
          f [d] g4 c\fermata cis
          d8 [e] f [fis] g [gis] a4
          dis e a,\fermata \fine
        }

versoOneLyrics = \lyricmode {\set stanza = 1
      Wer nur den lie -- ben Gott lässt wal - ten
      und hof -- fet auf ihn al -- le -- zeit,
      Wer Gott, dem Al -- ler -- höch -- sten, traut,
      der hat auf kei -- nen Sand ge -- baut.

      
    }

sopranoVersoOneLyrics = \lyricmode {\set stanza = 1
      den wird er wun -- der -- bar er -- hal - ten
      in al -- ler Not und Trau -- rig -- keit.
    }
