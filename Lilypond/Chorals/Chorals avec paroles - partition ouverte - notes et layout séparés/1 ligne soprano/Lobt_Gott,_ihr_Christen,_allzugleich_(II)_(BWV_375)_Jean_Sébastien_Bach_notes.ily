sopranoLyrics = \lyricmode {
      Lobt Gott, ihr Chris -- ten all -- zu -- gleich,
      in sei -- nem höch -- sten Thron,
      der heut' auf schleußt sein Him -- mel -- reich
      und schenkt uns sei -- nen Sohn, __ _ _
      und schenkt uns sei -- nen Sohn.
    }

