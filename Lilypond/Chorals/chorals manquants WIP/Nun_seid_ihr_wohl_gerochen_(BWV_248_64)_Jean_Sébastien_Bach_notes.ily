sopranoMusic = {
  s2. \repeat volta 2 { fis'4
  b' a' g' fis'
  e'2 fis'4 r
  r2 r4 cis''
  d'' d'' cis''8. d''32 [e''] cis''4
  b' }
  r4 r2 r r4 d''
  cis'' a' b' cis''
  d''2 d''4 r
  r a' b' a'
  g' g'8 [fis'] fis'4 r
  r r r d''
  cis'' e'' d'' cis''
  b'2 cis''4 r
  r r r fis'
  g' fis' e' a'
  fis'1 \fine
}

altoMusic = {
  s2. \repeat volta 2 { d'4
  d'8 [e'] fis'4 b8 [cis'] d'4
  d' cis' d' r
  r2 r4 ais'
  b' b' b' ais'
  fis' }
  r4 r2 r r4 b'
  a' a'8 [g'16 fis'] g'4 g'8 [e']
  d'4. b'8 a'4 r
  r a'8 [fis'] g'4 fis'
  fis'8 [e'] e'4 cis' r
  r2 r4 b'
  a'4. e'8 fis'4. e'8
  fis' [d'] e'4 e' r
  r2 r4 fis'
  b8 [e'] d'4 d'8 [cis'16 b] cis'4
  d'1 \fine
}

tenorMusic = {
  s2. \repeat volta 2 { a4
  b8 [cis'] d'4 g a
  b8 [g e a] a4 r
  r2 r4 fis'
  fis' d'8 [fis'] g' [e'] fis' [cis']
  d'4 }
  r r2 r r4 e'
  e' d' d' e'8 [cis']
  fis'4. b8 fis'4 r
  r d' d' d'
  b b8 [ais] ais4 r
  r r r e'
  e'4. b8 a4. a8
  a [b] gis4 a r
  r r r d'
  d'8 [cis'16 b] a4 a a
  a1 \fine
}

bassMusic = {
  s2. \repeat volta 2 { d4
  g fis b a
  g a d r
  r2 r4 fis
  b8 [fis] g [d] e [cis] fis4
  b, }
  r4 r2 r r4 a8 [gis]
  a [g] fis [d] g [fis] e [a]
  b [a b g] d4 r
  r fis8 [d] g4 d8 [b,]
  e4 e fis r
  r2 r4 gis8 [e]
  a4. gis8 fis4. cis8
  d [b,] e4 a, r
  r2 r4 d
  e fis8 [g] a [g] a [a,]
  d1 \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Nun seid ihr wohl ge -- ro -- chen
  an eu -- rer Fein -- _ de Schar,
  Tod, Teu -- fel, Sünd und Höl -- le
  sind ganz und gar ge -- schwächt;
  bei Gott hat sei -- ne Stel -- le
  das mensch -- li -- che Ge -- schlecht.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  denn Chris -- tus hat zer -- bro -- chen,
  was euch zu -- wi -- _ der war.
}

