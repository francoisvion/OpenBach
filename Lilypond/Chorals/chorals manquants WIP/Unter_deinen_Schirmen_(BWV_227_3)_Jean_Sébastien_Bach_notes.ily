sopranoOneMusic = {
\repeat volta 2 {
  b'4 b' a' g'
  fis'2 e'\fermata
  b'4 cis'' d'' b'
  e''2 dis''\fermata
  e''8 [fis''] g''4 fis''4. e''8
  e''1\fermata }
  b'4 b' c'' b'
  r8 g' [g'] fis' g'2\fermata
  b'4 cis'' d'' b'
  e'' d''8 [cis''] cis''2
  b'\fermata b'8 [a'] b'4
  a' g'8 [fis'] fis'2
  e'1\fermata \fine
}

sopranoTwoMusic = {
\repeat volta 2 {
  g'4 g' fis' e'
  e' dis' e'2\fermata
  d'4 a' a' b'
  b' a' b'2\fermata
  e''4 e'' e'' dis''
  e''1\fermata }
  g'4 a' g'8 [d'] g'4
  a'4. g'8 g'2\fermata
  g'8 [fis'] e'4 a' g'
  g'8 [fis'] b'4 b' ais'
  b'2\fermata g'8 [a'] g'4
  fis' e' e' dis'
  e'1\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  e'4 b c' b8 [e']
  c'4 b b2\fermata
  g'8 [fis'] e'4 d' d'8 [g']
  g' [a'16 g'] fis'8 [e'] fis'2\fermata
  g'8 [a'] b' [c''] fis' [g'] a'4
  g'1\fermata }
  e'4 fis' e'8 a' d' [g']
  e'4 d'8 d' d'2\fermata
  d'4 a' d' d'8 [g']
  e' [cis'] d'4 g' fis'
  fis'2\fermata g'8 [fis'] e' [d']
  c'4 b8 [e'] c'4 b
  b1\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  e8 [fis] g [e] a [fis] g [e]
  a [g fis a] g2\fermata
  g4 a a g
  c'8 [b] c'4 fis2\fermata
  b8 [a] g [e] b4 b
  b1\fermata }
  b8 e'4 dis'8 e' a b [g]
  c'4 c'8 a b2\fermata
  g4 a a b
  ais8 [cis'] fis' [b] e' [d' cis' e']
  dis'2\fermata e'4 e
  fis g8 [e] a [g fis a]
  gis1\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  e2~ e8 dis e c
  a,4 b, e2\fermata
  g~ g8 fis g e
  c2 b,\fermata
  g8 [c'] b [a] b4 b,
  e1\fermata }
  e2~ e8 fis g e
  c [a,] d4 g,2\fermata
  g~ g8 fis g e
  cis [ais] b [g] e4 fis
  b,2\fermata e~
  e8 dis e [c] a,4 b,
  e1\fermata \fine
}

sopranoOneLyricsOne = \lyricmode {\set stanza = 1
  Un -- ter dei -- nen Schir -- men
  bin ich für den Stür -- men
  al -- ler Fein -- de frei.
  Ob es jetzt gleich kracht und blitzt,
  ob gleich Sünd und Höl -- le schre -- cken;
  Je -- sus will mich de -- cken.
}

sopranoOneLyricsTwo = \lyricmode {\set stanza = 2
  Lass den Sa -- tan wit -- tern,
  lass den Feind er -- bit -- tern,
  mir steht Je -- su bei.
}

