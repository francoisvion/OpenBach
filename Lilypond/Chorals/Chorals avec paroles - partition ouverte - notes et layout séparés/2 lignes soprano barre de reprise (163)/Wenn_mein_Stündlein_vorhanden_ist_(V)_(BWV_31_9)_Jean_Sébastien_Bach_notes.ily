sopranoMusic = {
\repeat volta 2 {
  \partial 4 c''4
  g' a' b' c''
  d'' e'' c''\fermata e''8 [f'']
  g''4 g'' e''8 [f''] g''4
  f''2 e''4\fermata } e''
  f'' e'' d'' c''8 [d'']
  e''4 e''8 [d''] c''4\fermata d''
  e'' e'' a' b'
  c''8 [b'] a'4 g'\fermata g'
  c'' d'' e'' d''8 [e'']
  f''4 e''8 [d''] d''2
  c''2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 e'4
  e' fis' g' g'
  f' e' a'\fermata g'
  g'8 [f'] e' [d'] c'4 b
  c' g' g'\fermata } g'
  d' c' g'4. f'8
  e' [f'] g'4 g'8 [f'\fermata] b4
  c'8 [d'] e' [a] fis'4 g'
  a'8 [g'] fis'4 g'\fermata d'
  g'4. f'8 e' [f'] g'4
  f' g'8 [a'16 bes'] a'4 g'
  g'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 g4
  c' c' d' g8 [a]
  b4 c' c'\fermata c'8 [d']
  e' [f'] g' [g] c'4 g
  a8 [f] g4 c\fermata } c'
  c'8 [b16 a] g4 d'8 [e'16 f'] e'8 [d']
  c'4 c' c'\fermata f
  g c'8 [d'16 e'] d'4. c'16 [b]
  a8 [b16 c'] d'8 [d'] d'4\fermata b8 [a]
  g [a] b4 c' d'8 [g] c' [d'] e'4 f'8 [e'] d'[e'16 f']
  e'2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 c4
  c'8 [b] a4 g8 [f] e4
  d c f\fermata c
  c' g a e
  a, b, c\fermata } c
  d e8 [f] g4 a8 [b]
  c'4 c f\fermata d
  c c c' b
  fis8 [g] d4 g,\fermata g8 [f]
  e [f] e [d] c [d c b,]
  a,4 g, f, g,
  c2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  So fahr ich hin zu Je -- su Christ,
  mein' Arm tu ich aus -- stre -- cken;
  denn Je -- sus Chris -- tus, Got -- tes Sohn,
  der wird die Him -- mels -- tür auf -- tun,
  mich führn zum ew -- _ _ gen Le -- ben.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  so schlaf ich ein und ru -- he fein,
  kein Mensch kann mich auf -- we -- cken,
}

