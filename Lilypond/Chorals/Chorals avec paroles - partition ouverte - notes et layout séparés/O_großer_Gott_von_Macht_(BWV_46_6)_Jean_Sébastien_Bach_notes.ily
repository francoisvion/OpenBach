sopranoMusic = {
  \tempo \markup{\tiny \italic "Interludes instrumentaux absents"}
  \partial 4  a'4
  bes' c'' d'' a'8 [b']
  c''2 \bar "'" r2 
  r4 \bar "'" g'4 g' a' 
  bes' c'' a'2 
  r2 r4 \bar "'"  f'
  f' g' a' bes'
  c''2 r4 d''
  bes'8 [c''] d''4 c'' c''
  bes'2 \bar "'"  r2 
  r4 \bar "'"  d'' d'' d'' 
  c'' c'' bes' bes' 
  a'2 r4 a' 
  bes' a' g' g' 
  f' f' e'2 
  r2 r4 \bar "'"  g'
  g' a'8 [bes'] c''4 bes'
  a'2 g'
  r4 g' g' a'8 [b']
  c''4 bes' a'2
  a'1~
  a'2. \fine
}

