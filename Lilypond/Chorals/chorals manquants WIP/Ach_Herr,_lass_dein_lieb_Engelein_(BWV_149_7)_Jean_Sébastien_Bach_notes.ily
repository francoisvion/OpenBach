sopranoMusic = {
\repeat volta 2 {
  \partial 4 c''4
  b' a' g'8 [fis'] e'4
  a' a' g'\fermata c''
  b' a' g'8 [fis'] e'4
  a' a' g'\fermata g'
  a' b' c''8 [d''] e''4
  d''2 c''4\fermata }
  c'' c'' d'' c''8 [b']
  a' [b'] c''4 c'' b'\fermata
  b' c'' d'' c''8 [b']
  a' [b'] c''4 c'' b'\fermata
  e'' f''8 [e''] d''4 e''8 [d'']
  c''4 c'' b' c''\fermata
  b' c'' b' a'
  g' g' fis' g'\fermata
  e'' d'' c'' b'\fermata
  e'' f''8 [e''] d''4 e''8 [d'']
  c''4 c'' b' c''\fermata
  c'' c'' c'' d''
  c'' c''2.
  b'4 c''1\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 e'4
  d'8 [e'] f'4 e'8 [d'] c'4
  c' f' e'\fermata fis'
  g' dis' e' b
  e'4. dis'8 e'4\fermata e'
  e'8 [d'] c' [b] a4 a'
  a' g'8 [f'] e'4\fermata }
  e' f' f' e'8 [d']
  c' [b] a4 fis' g'\fermata
  g' g'8 [f'] e' [d'] e'4
  f' g' a'8 [d'] d'4\fermata
  e'8 [d'] c'4 g'8 [f'] e'4
  a' a' g' g'\fermata
  g' a' g' fis'
  e' e' d' d'\fermata
  e'8 [fis'] g' [fis'] e' [fis'] gis'4\fermata
  a'8 [g'] f'4 g'8 [f'] e' [f']
  g'4 g' g' g'\fermata
  e'8 [fis'] g'4 f'8 [e'] f'4
  e' a' d' d'2
  e'1\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 g8 [a]
  b [c'] d' [c'] b4 c'8 [b]
  a [b] c'4 c'\fermata c'
  d'8 [e'] fis'4 b8 [a] g4
  g8 [fis16 e] c'8 [b] b4\fermata c'8 [b]
  a4 e' e'8 [d'] c'4
  c' b g\fermata }
  g a a8 [b] c' [d']
  e'4 d'8 [c'] d'4 d'\fermata
  d' g g g
  d' c'8 [b] a4 g\fermata
  b a d' c'8 [d']
  e'4 d' d' e'\fermata
  d' d' d'8 [c'] c' [b]
  b4 b8 [a] a4 b\fermata
  g8 [a] b4 c'8 [d'] e'4\fermata
  e' a b c'
  c'8 [d'] e' [c'] d'4 e'\fermata
  c' c'8 [bes] a4 a8 [g]
  g4 fis8 [g] a4 g2
  g1\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 c4
  g d e a8 [g]
  f [g] a [b] c'4\fermata a
  g fis e~ e8 d
  c [a,] fis, [b,] e4\fermata e
  fis gis a~ a8 g
  f [d] g4 c\fermata }
  c f8 [e] d4 a~
  a8 g fis [e] d4 g\fermata
  g8 [f] e [d] c [b,] c4
  d e fis g\fermata
  gis a b c'8 [b]
  a [g] f [d] g4 c\fermata
  g g8 [fis] fis [e] e [dis]
  e [d] d [cis] d4 g,\fermata
  c g a e\fermata
  cis d g c8 [d]
  e [f] g4 g, c\fermata
  a e f b,
  c8 [b,] a, [g,] fis,4 g,2
  c1\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Ach, Herr, lass dein lieb En -- ge -- lein
  am letz -- ten End die See -- le mein
  in A -- bra -- hams Schoß tra -- gen,
  Als -- denn vom Tod er -- we -- cke mich,
  dass mei -- ne Au -- gen se -- hen dich
  in al -- ler Freud, o Got -- tes Sohn,
  mein Hei -- land und Ge -- na -- den -- thron!
  Herr Je -- su Christ,
  er -- hö -- re mich, er -- hö -- re mich,
  ich will dich prei -- sen e -- wig -- lich!
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  den Leib in seim Schlaf -- käm -- mer -- lein
  gar sanft ohn ein -- ge Qual und Pein
  ruhn bis am jüng -- sten Ta -- ge!
}

