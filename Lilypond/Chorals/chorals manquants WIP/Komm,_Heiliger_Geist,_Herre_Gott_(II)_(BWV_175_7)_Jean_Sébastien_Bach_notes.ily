sopranoLyrics = \lyricmode {
  Nun, wer -- ter Geist, ich folg dir, __ _
  hilf, __ _ _
  dass ich su -- che für und für __ _
  nach dei -- nem Wort, ein an -- der Le -- ben, __ _
  das du mir willst aus __ Gna -- den ge -- ben.
  Dein Wort ist ja der Mor -- gen stern,
  der herr -- lich leuch -- tet nah und fern.
  Drum will ich die mich __ an -- ders leh -- ren, __ _
  in E -- wig keit, mein Gott, nicht hö ren. Al -- le lu -- ja, __ _ _
  Al -- le lu -- ja!
}

