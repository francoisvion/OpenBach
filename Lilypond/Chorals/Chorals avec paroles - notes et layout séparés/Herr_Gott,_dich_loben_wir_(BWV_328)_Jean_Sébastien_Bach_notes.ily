          \repeat volta 2 {
          \partial 4 c'
          g4. d'8 d'4 d'
          d'4. cis'8 d'4\fermata f8 [g]
          a [f] g4. fis8 d'4
          c'8 [e'] d'8. [c'16] b4\fermata }
          \repeat volta 2 {
