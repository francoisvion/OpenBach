          d' d' g'8 fis' g'4
          fis'2.\fermata e'4
          fis'8 e' d'4 d' cis'
          a2.\fermata }
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  a4
          a g a d'
          d'2.\fermata d'4
          cis'8 b a4 a a
          a2 fis4\fermata a
          g b cis'8 d' d' cis'
          a2.\fermata a4
          a b a a
          a gis cis'\fermata cis'
          d' d' a d'
          d'2.\fermata
          fis'4
          e' b b8 a a gis
          a2.\fermata a4
          g a e'8 d' e'4
          d'2.\fermata e'4
          a b b a8 g
          fis2.\fermata }
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  cis4
          d e fis d
          g2.\fermata gis4
