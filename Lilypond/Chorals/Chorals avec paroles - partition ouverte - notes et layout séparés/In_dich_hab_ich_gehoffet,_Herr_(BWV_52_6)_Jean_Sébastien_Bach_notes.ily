sopranoLyrics = \lyricmode {
  In dich hab ich ge -- hof -- fet, Herr,
  hilf, dass ich nicht zu -- schan -- den werd,
  noch e -- wig -- lich zu Spot -- te!
  Das bitt ich __ dich,
  er hal -- te mich
  in dei -- ner Treu, __ Herr __ Got -- te!
}

