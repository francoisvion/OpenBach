sopranoMusic = {
  \repeat volta 2 {
    \partial 4  d''4
    e'' d''8 [c''] b' [c''] d''4
    c''8 [b'] c''4 b'\fermata a'
    b' c'' d'' c''8 [b']
    a' [g'] a'4 g'\fermata } g'
  a' b' c''8 [b'] a'4
  b' a' g'\fermata g'8 [a']
  b'4 c'' d'' e''
  b' cis'' d''\fermata b'8 [c'']
  d''4 e'' d''8 [c''] b'4
  c''2 b'4\fermata e''
  e'' e'' a' d''
  c'' b' a'\fermata c''
  b' a' g' a'8 [g']
  f'4 e' d'\fermata d'
  g' a' b'4. c''8
  d''4 c''8 [b'] a'4 b'8 [c'']
  a'2 g'4\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial 4  g'4
    g' fis' g' fis'
    e'8 g'4 fis'8 g'4\fermata a'
    g' g' g' g'
    g' fis' d'\fermata } d'
  d'8 [e'] fis'4 e' e'8 [d']
  d'4 c' b\fermata e'
  d' e' f' e'8 [fis']
  g' [fis'] g' [a'] fis'4\fermata d'
  g' g' a' b'
  b'8 [gis'] a'4 gis'\fermata b'
  a' e'8 [c'] d' [e'] f'4
  e' d' c'\fermata a'
  d'8 [e'] f'4 e'8 [d'] e'4
  e'8 d'4 cis'8 d'4\fermata d'8 [c']
  b [a] g [fis] g4 g'
  fis' g'2 g'4~
  g' fis' d'\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial 4  b4
    c'8 [b] a4 e' a8 [b]
    c' [e'] d'4 d'\fermata d'
    d' g8 [a] b [g] e'4
    a8 [b] c'4 b\fermata } b
  a d' g a
  a8 g4 fis8 g4\fermata g
  g g g g
  g8 [a16 b] a4 a\fermata g
  g8 [d'] c' [b] a4 e'
  e'2 e'4\fermata e'8 [d']
  c' [b] a4 a8 [gis] a [b]
  gis a4 gis8 a4\fermata e8 [fis]
  g4 d'8 [c'] bes4 a
  a g fis\fermata fis
  g d' d' e'
  d'2 e'8 [d'] c'4
  d'8 [e'] d' [c'] b4\fermata \fine
}

bassMusic = {
  \repeat volta 2 {
    \partial 4  g4
    c d e fis8 [g]
    a4 d g\fermata fis
    g8 [fis] e4 b, c
    d2 g,4\fermata } g
  fis e8 [d] e4 fis
  g d g,\fermata c
  g8 [f] e [d] c [b,] c [d]
  e4 a, d\fermata g8 [a]
  b4 c' fis gis
  a a, e\fermata gis,
  a,8 [b,] c [a,] f4 e8 [d]
  e4 e, a,\fermata a,
  b,8 [cis] d4 d cis
  d a, d\fermata b,
  e d g8 [fis] e4
  b,8 [a,] g,4 c8 [b,] a,4
  d8 [c] d4 g,\fermata \fine
}

sopranoLyricsOne = \lyricmode {
  \tweak X-offset #-4 "1. An" Was -- ser -- flüs -- sen Ba -- by -- lon,
  da sa -- ßen wir mit Schmer -- _ zen,
  Wir hing -- en auf mit schwe -- rem Mut
  die Har -- fen und die Or -- geln gut
  an ih -- re Bäum' der Wei -- den,
  die drin -- nen sind in ih -- rem Land;
  da muss -- ten wir viel Schmach und Schand'
  täg -- lich von ih -- _ _ nen lei -- _ _ den.
}

sopranoLyricsTwo = \lyricmode {
  als wir ge -- dach -- ten an Zi -- on,
  da wein -- ten wir von Her -- _ zen,
}

sopranoLyricsThree = \lyricmode {
  \tweak X-offset #-4 "2. Ein" Lämm -- lein geht und trägt die Schuld
  der Welt und ih -- rer Kin -- _ der;
  Es geht da -- hin, wird matt und krank,
  er -- gibt sich auf die Wür -- ge -- bank,
  ver -- zeiht sich al -- ler Freu -- den;
  es nim -- met an Schmach, Hohn und Spott,
  Angst, Wun -- den, Strie -- men, Kreuz und Tod
  und spricht: Ich will __ _ _ gern lei -- _ _ den.
}

sopranoLyricsFour = \lyricmode {
  Es geht und bü -- ßet in Ge -- duld
  die Sün -- den al -- ler Sün -- _ der.
}

