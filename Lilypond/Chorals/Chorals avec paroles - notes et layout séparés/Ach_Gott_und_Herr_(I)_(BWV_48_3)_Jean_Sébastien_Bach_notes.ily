sopranoLyrics = \lyricmode {
      Solls ja so sein, dass Straf und Pein
      auf Sün -- de fol -- gen mü -- ßen,
      so fahr hier fort
      und scho -- ne dort,
      und laß mich hier wohl bü - - - ßen.
    }
