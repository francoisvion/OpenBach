sopranoMusic = {
\repeat volta 2 {
  \partial 4 f'4
  bes' c'' d'' ees''
  f''4. ees''8 d''4\fermata g''
  f'' ees'' d'' ees''
  c''2\trill bes'4\fermata }
  f'' g'' g'' c''
  c'' f'' f'' bes'
  d'' c'' bes' a'
  bes' g'2 f'4\fermata
  f'' ees'' d'' c''
  d'' c''2 bes'4\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 d'4
  f' f' f' bes'
  bes' a' f'\fermata ees'8 [d']
  c'4 g' f' g'
  f'2 f'4\fermata }
  bes' bes' c''8 [bes'] a'4
  a' bes'4. aes'8 g'4
  f' e' d' c'
  d' c'2 c'4\fermata
  bes bes8 [c'] d' [ees'] f'4
  f' f'2 d'4\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 bes4
  d' c' bes bes8 [c']
  d'4 c' bes\fermata bes
  a bes8 [c'] d'4 c'8 [bes]
  bes4 a bes\fermata }
  d' ees'8 [d'] c'4 f'
  f' f'8 [ees'] d' [c'] bes4
  bes8 [a] g4 f f8 [a]
  g [f] f4 e f\fermata
  f g f8 [g] a4
  bes bes a f\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 bes,4
  bes a bes g
  d f bes,\fermata ees
  f g8 [a] bes4 ees
  f2 bes,4\fermata }
  bes ees e f
  ees d d ees
  bes, c d8 [e] f4
  bes, c2 f,4\fermata
  d g8 [a] bes4 f8 [ees]
  d [bes,] f,2 bes,4\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Was Gott tut, das ist wohl -- ge -- tan,
  da -- bei will ich ver -- blei -- ben.
  so wird Got mich ganz vä -- ter -- lich in sei -- nen Ar -- men hal -- ten:
  drum lass ich ihn nur wal -- ten.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Es mag mich auf die rau -- he -- Bahn
  Not, -- Tod und E lend -- trei -- ben.
}

