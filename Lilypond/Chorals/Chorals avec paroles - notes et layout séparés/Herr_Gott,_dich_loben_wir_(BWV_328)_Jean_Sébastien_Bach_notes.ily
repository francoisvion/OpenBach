          c'4 c' c' c'~
          c'4. b8 g4\fermata }
          \partial 4 a
          g c8 [g] g4 g8 [d]
          a4. d8 d4\fermata b
          c'8 [d'] e' [c'] a [c'] d'16 [e' f'8]
           f' [e'] d' [a] a4\fermata e
          d a8 [g] g4 g
          c8 [a] g8. [f16] e4\fermata e8 [f]
          g4 c'8 [bes] a f4 g16 [a]
          bes4 a a\fermata a
          g g g g
          f8 [a] g8. [f16] e4\fermata e8 [f]
          g [a] bes4 c' d'8. [c'16]
          bes8 [a] a4 a\fermata a
