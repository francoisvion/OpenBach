sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          bes'4 bes' f''
          d''4. c''8 bes'4
          a' bes'8 a' g' f'
          bes'4 c'' d''8 ees''
          c''2 bes'4\fermata }
          f'' ees''8 d'' c'' bes'
          g''2\fermata r4
          d'' ees'' f''
          f'' g''8 f'' ees'' d''
          c''2\fermata r4
          f' g' a'
          bes' c'' d''8 ees''
          c''2 bes'4\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          f'4 f' f'
          f'4. f'8 g'4
          c' c' c'
          f' g'8 a' bes' c''
          a'2 f'4\fermata }
          bes' a' f'
          bes'2\fermata r4
          bes' bes' a'8 g'
          f'4 bes' g'
          a'2\fermata r4
          f' c' c'
          bes f' f'
          f'4. ees'8 d'4\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          d'4 d' c'
          bes4. c'8 d' e'
          f'4 f' a
          bes ees f
          f' ees' d'\fermata }
          d' ees' f'
          ees'2\fermata r4
          f' g' c'
          c' bes bes
          f'2\fermata r4
          bes a8 g ees'4
          d' c' bes
          bes a f\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          bes4 bes a
          bes4. a8 g4
          f c ees
          d c bes,
          f2 bes,4\fermata }
          bes, c d
          ees2\fermata r4
          bes a8 g f ees
          d4 d ees
          f2\fermata r4
          d e fis
          g a bes
          f2 bes,4\fermata \fine
        }
