sopranoMusic = {
  \repeat volta 2 {
    \partial 4 fis'8 [g']
    a'4 b' a' d''
    d'' cis'' d''\fermata d''
    cis'' b' e''4. d''8
    cis''4 d''8 [e''] cis''2
    b'2.\fermata }
  b'4 b' b' cis''8 [b']
  a'4 a' gis' a'\fermata
  a' b' cis'' d''
  cis'' b'2 cis''4\fermata
  fis'8 [g'] a'4 b' a'
  d'' d'' cis'' d''\fermata
  d'' cis'' b' e''4.
  d''8 cis''4 d''8 [e''] cis''2
  b'2.\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial 4 d'8 [e']
    fis'4 gis' fis' fis'
    e' e' fis'\fermata fis'8 [gis']
    a' [g'] fis'4 g' fis'~
    fis' fis' g' fis'8 [e']
    d'2.\fermata }
  dis'4 e' e' e'
  fis' fis' e' e'\fermata
  fis' e' e' d'8 [e'16 fis']
  e'8 [fis'16 g'] fis'4 e'16 [d' cis' b] fis'4\fermata
  d'8 [e'] fis'4 gis' fis'
  fis' e' e' fis'\fermata
  fis'8 [gis'] a' [g'] fis'4 g'
  fis'~ fis' fis' g'
  fis'8 [e'] dis'2.\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial 4 b4
    cis' d' cis' b
    b a a\fermata b
    e' dis'8 [cis'] b4 b
    ais b2 ais4
    fis2.\fermata }
  fis4 gis8 [a] b [gis] a [b]
  cis'4 b b cis'\fermata
  d' d' cis' b4.
  ais8 b [cis'16 d'] e'4 ais\fermata
  b cis' d' cis'
  b b a a\fermata
  b e' dis'8 [cis'] b4
  b ais b2
  ais4 fis2.\fermata \fine
}

bassMusic = {
  \repeat volta 2 {
    \partial 4 b4
    fis eis fis b
    gis a d\fermata b,
    a, a g8 [fis16 e] b4
    fis8 [e] d4 e fis
    b,2.\fermata }
  b,4 e8 [fis] gis [e] a [gis]
  fis [e] d [b,] e4 a,\fermata
  d gis, ais, b,
  cis d8 [e16 fis] g4 fis\fermata
  b fis eis fis
  b gis a d\fermata
  b, a, a g8 [fis16 e]
  b4 fis8 [e] d4 e
  fis b,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
   Soll ich den auch des To -- des Weg
   und fin -- stre Stra -- _ _ ße rei -- sen,
   Du bist mein Hirt, der al -- les wird
   zu sol -- chem En -- de keh -- ren,
   dass ich ein -- mal in dei -- nem Saal
   dich e -- wig mö -- _ _ ge eh -- ren.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
   wohl -- an! ich tret auf Bahn und Steg,
   den mir dein Au -- _ _ gen wei -- sen.
}

