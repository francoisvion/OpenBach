sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  e'4
          a' g' f' e'
          d'2 e'4\fermata b'
          c'' c'' b' b'
          a'2.\fermata } c''4
          b' g' a' b'
          c''2 c''4\fermata g'
          a' g' a' f'
          e'2.\fermata c''4
          b'8 [c''] d''4 c'' b'
          a'2 b'4\fermata e'
          f' e' d' g'
          e'2.\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  b4
          e' e' d' cis'
          d'2 cis'4\fermata e'
          dis' e' fis' e'8 [d']
          c'2.\fermata } e'8 [fis']
          g'4 d' e' f'
          g' f' e'\fermata g'
          f' e'8 [d'] e'4 d'
          cis'2.\fermata d'4
          d' g'4. fis'8 g'4
          g' fis' g'\fermata g'
          d' c' c' b8 [c']
          d'4\fermata c' b \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  gis4
          a bes a g
          a8 [g16 f] g8 [d] a4\fermata b
          a a a gis
          a2.\fermata } a4
          d' b c' d'
          c'8 [bes] a4 g\fermata c'
          c' cis'8 [d'] a4 a
          a2.\fermata a4
          g8 [a] b4 c' d'
          e' d' d'\fermata c'8 [b]
          a4 g a g8 [a]
          b4\fermata a gis \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  d4
          c cis d e
          f bes, a,\fermata g
          fis e dis e
          a,2.\fermata } a4
          g f e d
          e f c\fermata e
          f bes cis d
          a,2.\fermata fis4
          g g, a, b,
          c d g,\fermata c
          d e fis g
          gis a e\fermata \fine
        }


