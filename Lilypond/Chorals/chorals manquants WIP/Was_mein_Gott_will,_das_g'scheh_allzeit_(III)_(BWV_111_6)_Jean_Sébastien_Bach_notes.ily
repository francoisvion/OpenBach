sopranoMusic = {
\repeat volta 2 {
  \partial 4 e'4
  g' a' g' c''
  c'' b' c'' c''
  b' a' d''4. c''8
  b'4 c'' b' b'
  a'2.\fermata }
  \partial 4 a'4
  a' a' b'4. a'8
  b'4 g' g' fis'
  g'2.\fermata g'4
  a' b' c'' b'
  a'2 b'4\fermata e'
  g' a' g' c''
  c'' b' c''\fermata c''
  b' a' d''4. c''8
  b'4 c'' b'2
  a'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 c'4
  c' c'8 [d'] e' [f'] g'4
  g' g' g' g'
  g' f'8 [e'] d' [e' e' fis']
  gis'4 a'4. gis'16 [fis'] gis'4
  e'2.\fermata }
  \partial 4 e'4
  d'4. fis'8 g'4. a'8
  g'4 g'8 [fis'] e'4 d'
  d'2. e'4
  fis'8 [e'] fis' [gis'] a'4 e'
  e' d'8 [e'16 f'] b4 c'
  c' c'8 [d'] e' [f'] g'4
  g' g' g' g'
  g' f'8 [e'] d' [e' e' fis']
  gis'4 a'4. gis'16 [fis'] gis'4
  e'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 a4
  g c' c' c'8 [d']
  e' [d'] d'4 e' e'
  d' d' a8 [b c' d']
  e'2. d'16 [c'] d'8
  c'2.\fermata }
  \partial 4 c'4
  c'8 [a] d'4 d'4. dis'8
  e'4 b c' a
  b2. c'8 [b]
  a4 d' e'8 [f'] g' [b]
  c'4 b8 [a] gis4 a
  g c' c' c'8 [d']
  e' [d'] d'4 e' e'
  d' d' a8 [b c' d']
  e'2. d'16 [c'] d'8
  c'2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 a4
  e f c8 [d] e [f]
  g4 g, c c
  g d8 [e] fis [gis] a4
  e8 [d c d] e2
  a,2.\fermata }
  \partial 4 a8 [g]
  fis [e] fis [d] g [a g fis]
  e [fis] e [d] c [a,] d4
  g,2. c4
  c' b a g
  f8 [e] f4 e a
  e f c8 [d] e [f]
  g4 g, c c
  g d8 [e] fis [gis] a4
  e8 [d] c [d] e2
  a,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Noch eins, Herr, will ich bit -- ten dich, du wirst mir's nicht __ _ ver -- _ sa -- _ gen:
  Hilf, steur und wehr, __ _ ach Gott, mein __ _ Herr,
  zu Eh -- ren dei -- nem Na -- men.
  Wer das be -- gehrt, dem wird's ge -- währt;
  drauf sprech ich frö -- _ lich: A -- _ men.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  wenn mich der bö -- se Geist an -- ficht, lass mich doch nicht __ _ ver -- _ za -- _ gen.
}

