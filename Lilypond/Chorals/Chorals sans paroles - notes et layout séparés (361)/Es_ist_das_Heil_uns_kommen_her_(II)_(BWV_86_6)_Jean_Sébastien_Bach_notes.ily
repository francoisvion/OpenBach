sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  b'4
          b' b' b' d''
          cis'' b' a'\fermata b'
          gis' e'8 fis' gis'4 ais'
          b' cis'' b'\fermata } b'
          e'' dis'' cis'' dis''
          e''8 dis'' cis''4 b'\fermata b'
          e'' b' cis'' gis'8 a'
          b'4 a' gis'\fermata gis'
          fis' a' gis' fis'
          cis' dis' e'\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  gis'4
          fis'8 gis' a'4 gis' fis'
          e'8 a'4 gis'8 e'4\fermata fis'
          e' e'8 dis' e'4 cis'
          fis'8 e'16 dis' e'4 dis'\fermata }
          e'8 fis'
          gis' ais' b'4 ais' b'
          b' fis' fis'\fermata gis'
          e'8 fis' gis'4 a' e'8 fis'
          gis'4 fis' eis'\fermata
          e'
          dis' cis' b b
          cis' b b\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  e'4
          fis' e'8 dis' e'4 a8 b
          cis'16 d' e'4 d'8 cis'4\fermata b
          b4. a8 gis4 fis
          fis8 b4 ais8 fis4\fermata } gis
          cis' fis fis' fis'
          b ais dis'\fermata e'
          b e' e' cis'
          d' cis' cis'\fermata b
          b e' e' dis'8 b
          fis2 gis4\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  e4
          dis b, e fis8 gis
          a4 e a,\fermata dis
          e8 fis gis4 cis fis8 e
          dis cis16 b, fis4 b,\fermata } e
          cis dis8 e fis4 b
          gis8 e fis4 b,\fermata e
          gis e a8 b cis'4
          eis fis cis\fermata e
          b, cis8 dis e4 b,
          ais, b, e,\fermata \fine
        }
