sopranoLyrics = \lyricmode {
  Drum schließ ich mich __ _ in __ dei -- ne Hän -- de
  und sa -- ge Welt, __ _ zu -- gu -- _ ter Nacht!
  Eilt gleich mein Le -- _ bens -- lauf zu En -- _ de,
  ist doch der Geist __ _ wohl __ an -- ge -- bracht.
  Er soll bei sei -- nem Schö -- _ pfer schwe -- _ ben,
  weil Je -- sus ist __ _ und bleibt __
  der wah -- re Weg __ _ _ _ _ _ zum Le -- _ ben.
}

