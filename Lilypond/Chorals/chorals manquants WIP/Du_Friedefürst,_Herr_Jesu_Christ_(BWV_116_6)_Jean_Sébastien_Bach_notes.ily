sopranoMusic = {
\repeat volta 2 {
  \partial 4 cis''8 [b']
  a'4 b' cis''8 [d''] e''4
  d'' d'' cis''\fermata }
  e'' d'' cis'' b'
  b' cis''2.
  b'4 b' b' cis''
  b' a'8 [gis'] a'4 gis'\fermata
  gis' a' b' cis''
  b'8 [cis''] d''4 cis''8 [b'] b'2
  a'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 a'8 [gis']
  fis'4 fis'8 [gis'] a'4 gis'
  a' b' a'\fermata }
  e' fis'8 [gis'] a'4 a'
  gis' a'2.
  a'4 gis'8 [a'] b'4 b'8 [a']
  a' [gis'] gis' [eis'] fis'4 eis'\fermata
  eis' fis' e'8 [d'] cis' [d']
  e'4 fis'8 [gis'] a'4 a'
  gis' e'2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 e'4
  e'8 [d'] d'4 cis' cis'
  b8 [a] e'4 e'\fermata }
  b8 [cis'] d'4 e' fis'
  e' e'2.
  fis'4 e' e' e'
  d' cis' dis' gis\fermata
  cis' cis' b a
  b a8 [b] cis' [a] e'4.
  d'8 cis'2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 a,4
  d b, fis cis
  fis gis a\fermata }
  gis fis e d
  e a,2.
  dis4 e8 [fis] gis [e] a [gis]
  fis [eis] fis4 bis, cis\fermata
  cis fis gis a
  gis fis e8 [d] e2
  a,2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Er -- leucht auch un -- sern Sinn und Herz
  durch den Geist dei -- ner Gnad, O Je -- su Christ, al -- lein du bist,
  der solchs wohl kann __ _ _ aus -- rich -- ten.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  dass wir nicht trei -- ben draus ein Scherz,
}

