  cis' d' e'8 d' cis'4
  d' e' ais8 b cis'4~
  cis' b2 ais4
  b2\fermata }
  r4 d' d'8 b cis'4
  cis'8 a b4 b cis'
  d'\fermata fis' e' e'
  d' d'8 cis' b4 b
  b2\fermata r4 b
  b8 a4 gis8 fis4 fis
  g8 a b cis' dis'4 r
  r b8 cis'16 d' cis'4 d'8 e'
  fis'4 e' d'\fermata r
  r d' gis ais
  b8 cis' d'2 cis'4~
  cis' b2 ais4
