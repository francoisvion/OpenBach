sopranoMusic = {
\repeat volta 2 {
  a'4 b' c'' b'
  a' b'8 [c''16 d''] c''4 b'\fermata
  c'' b' a' b'
  c'' d'' e''2\fermata }
  b'4 c'' d''8 [c''] b'4
  c'' b'8 [a'] a'4 g'\fermata
  b' b' a' g'
  fis' g' fis' e'\fermata
  b' c'' d'' e''
  d''4. c''8 c''2\fermata
  e''4 e'' d'' c''
  b'4. a'8 a'2\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  e'4 e' e' e'8 [d']
  c'4 f' e' e'\fermata
  e' e' e'8 [fis'] gis'4
  a'8 [c''] b' [a'] gis'2\fermata }
  gis'4 a' a' g'
  g' g' fis' d'\fermata
  g'8 [a'] g' [fis'] e'4 e'
  dis' e' dis' b\fermata
  e' e' g' g'
  g'8 [d'] e' [f'] e'2\fermata
  g'4 c''8 [b'] a' [gis'] a'4
  a'8 [b'] gis'4 e'2\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  c'4 b a gis
  a a a gis\fermata
  a gis a d'
  e' f' b2\fermata }
  e'4 e' d' d'
  c'8 [d'] e'4 a8 [b16 c'] b4\fermata
  d' e' a8 [b] c'4
  fis b b8 [a] gis4\fermata
  gis a b c'
  c'8 [d'] b4 c'2\fermata
  c'8 [d'] e'4 f' a
  e'8 [b] cis' [d'] cis'2\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  a4 gis a e
  f8 [e] d4 a, e\fermata
  a e8 [d] c4 b,
  a,8 [g,] f,4 e,2\fermata }
  e4 a8 [g] fis4 g8 [fis]
  e [d] c4 d g,\fermata
  g8 [fis] e [d] c [b,] a,4
  b,8 [a,] g, [a,] b,4 e,\fermata
  e a8 [g] f [e] d [c]
  g4 g, c2\fermata
  c'8 [b] a [g] f [e] f [d]
  e4 e, a,2\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Ach, ich ha -- be schon er -- bli -- cket
  die -- se gro -- ße Herr -- lich -- keit.
  mit der güld -- nen Eh -- ren -- kro -- ne
  steh ich da vor Got -- tes Thro -- ne,
  schau -- e sol -- che Freu -- de an,
  die kein En -- de neh -- men kann.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Jetz -- und werd ich schön ge -- schmü -- cket
  mit dem wei -- ßen Him -- mels -- kleid;
}

