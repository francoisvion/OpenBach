sopranoMusic = {
\repeat volta 2 {
  \partial 4 d''4
  a' b'8 [cis''] d'' [e''] fis''4
  e'' d''2 cis''4
  d''2\fermata r4 fis''
  e'' d'' cis''8 [b'] a'4
  b' cis''8 [d''] e''2~
  e''4 d'' cis''2
  b'\fermata r4 }
  fis'' 
  g'' e'' fis'' d'' e'' fis''
  b'\fermata fis'' 
  g'' e'' fis'' d''
  \omit \time 2/4 e'' fis''
  \omit \time 4/4 b'2\fermata r4 d''
  cis'' b' a' b'
  g' g' fis'\fermata r
  r b' a' d''~
  d'' cis'' d''\fermata r
  r a' b' cis''
  d''8 [e''] fis''2 e''4
  e'' d'' cis'' cis''
  b'2\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 fis'8 [g']
  a'4 g' a' ais'8 [b']
  cis''4 fis' e' e'
  fis'2\fermata r4 a'
  a'8 [g'] fis'4 g' fis'
  g'2. fis'8 [gis']
  ais'4 b'8 [a'] g'4 fis'8 [e']
  d'2\fermata r4 }
  b' b' a'
  a' g' g' fis'
  fis'\fermata b' b' a'
  a' g'8 [fis']
  \omit \time 2/4 e'4 a'
  \omit \time 4/4 
  g'2\fermata r4 fis'
  eis' fis'8 [gis'] cis'4 fis'
  fis' e' dis'\fermata r
  r d'2 a'4~
  a' g' fis'\fermata r
  r fis' e' e'
  d' d''8 [cis''] b' [ais'] b' [cis'']
  ais'4 b'8 [a'] g'4 fis'8 [e']
  dis'2\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 a4
  d' d' d' d'
  cis' d'8 [cis'] b4 a
  a2\fermata r4 d'
  cis' d' e'8 [d'] cis'4
  d' e' ais8 [b] cis'4~
  cis' b2 ais4
  b2\fermata r4 }
  d' d'8 [b] cis'4
  cis'8 [a] b4 b cis'
  d'\fermata fis' e' e'
  d' d'8 [cis'] \omit \time 2/4 b4 b
  \omit \time 4/4  b2\fermata r4 b
  b8 a4 gis8 fis4 fis
  g8 [a] b [cis'] dis'4\fermata r
  r b8 [cis'16 d'] cis'4 d'8 [e']
  fis'4 e' d'\fermata r
  r d' gis ais
  b8 [cis'] d'2 cis'4~
  cis' b2 ais4
  b2\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 d8 [e]
  fis4 g fis4. gis8
  ais4 b8 [a] gis4 a
  d2\fermata r4 d'
  a b e fis~
  fis e8 [d] cis [b,] ais, [cis]
  fis4 g8 [fis] e4 fis
  b,2\fermata r4 }
  b e a
  d g8 [fis] e4 ais,
  b,\fermata d' d' cis'
  cis' b8 [a]
  \omit \time 2/4 g [fis] e [dis]
  \omit \time 4/4 
  e2\fermata r4 b,
  cis dis8 [eis] fis4 dis
  e8 [fis] g [a] b4\fermata r
  r g2 fis8 [g]
  a4 a, d\fermata r
  r d d' cis'
  b4. a8 g [fis] g [e]
  fis4 g8 [fis] e4 fis
  b,2\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Al -- lein zu dir, Herr Je -- _ su Christ,
  mein Hoff -- nung steht auf Er -- _ _ _ _ den.
  Von An -- be -- ginn ist nichts er -- korn,
  auf Er -- den ist kein Mensch ge -- born,
  der mir aus Nö -- ten hel -- fen kann; ich ruf __ dich an,
  zu dem ich mein Ver -- trau -- _ _ _ en han.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Ich weiß, dass du mein Trö -- _ ster bist,
  kein Trost mag mir sonst wer -- _ _ _ _ en.
}

