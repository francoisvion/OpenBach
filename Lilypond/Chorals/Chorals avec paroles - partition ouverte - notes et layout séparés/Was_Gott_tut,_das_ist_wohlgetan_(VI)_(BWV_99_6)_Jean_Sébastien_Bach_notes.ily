sopranoMusic = {
\repeat volta 2 {
  \partial 4 d'4
  g' a' b' c''
  d''4. c''8 b'4\fermata e''
  d'' c'' b'8 [a'] b'4
  a'2 g'4\fermata }
  d'' e'' e'' a'\fermata
  a' d'' d'' g'\fermata
  b' a' g' fis'8 [e']
  fis'4 e'2 d'4\fermata
  d'' c'' b' a'
  b'8 [c''] a'2 g'4\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 b8 [c']
  d'4 d' g' g'
  g' fis' g'\fermata g'
  fis' e' d' g'
  g' fis' d'\fermata }
  g' g' a'8 [g'] fis'4\fermata
  fis' fis' fis' e'\fermata
  e' e' e' e'
  d' d' cis' a\fermata
  fis' g'8 [a'] d' [e'] fis'4
  g' g'8 [fis'16 e'] fis'4 d'\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 g8 [a]
  b4 a e' e'
  d'8 [c'16 b] a8 [d'] d'4\fermata c'8 [b]
  a4 g8 [a] b [c'] d'4
  d'8 [c'16 b] c'8 [a] b4\fermata }
  b c'8 [d'] e'4 d'\fermata
  cis' cis'8 [ais] b4 b\fermata
  g a8 [b] cis'4 a
  b b a8 [g] fis4\fermata
  b b8 [a] b [c'] d'4
  d' d'8 [a16 b] c'4 b\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 g,4
  g fis e d8 [c]
  b, [c] d4 g,\fermata c
  d e8 [fis] g4 b,8 [c]
  d2 g,4\fermata }
  g c cis d\fermata
  fis b,8 [cis] d [b,] e4\fermata
  e8 [d] cis4 b,8 [a,] d [cis]
  b, [a,] g,4 a, d\fermata
  b, e8 [fis] g4 d8 [c]
  b, [g,] d2 g,4\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Was Gott tut, das ist wohl -- ge -- tan,
  da -- bei will ich ver -- blei -- ben.
  so wird Gott mich
  ganz vä -- ter -- lich
  in sei -- nen Ar -- men hal -- ten;
  drum lass ich ihn nur wal -- ten.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  es mag mich auf die rau -- he Bahn
  Not, Tod und E -- lend trei -- ben,
}

