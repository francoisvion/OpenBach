sopranoMusic = {
\repeat volta 2 {
  \partial 4 b'4
  a' b'8 [cis''] d''4 e''
  d'' cis'' b'\fermata b'
  g' a' b' a'8 [g']
  fis'2 e'4\fermata }
  r e' g' a'
  e' g' a' b'\fermata
  b' e'' dis'' e''
  fis'' d'' cis'' b'\fermata
  b'8 [c''] d''4 b' d''
  a' g' fis' e'2\fermata
  b'4 a' g'
  fis' e'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 g'4
  fis' fis'8 [ais'] b'4 cis''
  b' ais' fis'\fermata fis'
  e' d' d' e'
  e' dis' b\fermata }
  r b e'8 [d'] e'4
  c' b d' d'\fermata
  d' g' a' g'
  b' b' ais' fis'\fermata
  g' a' b' g'
  a' e' d' c'2\fermata
  fis' e'4
  dis' b2.\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 e'8 [d']
  cis'4 d'8 [e'] fis'4 fis'
  fis' fis'8 [e'] dis'4\fermata b
  b a g8 [a] b4
  c' b8 [a] g4\fermata }
  r g g c'
  a g d' b\fermata
  g b a b
  b fis' fis'8 [e'] d'4\fermata
  b a g g
  fis g a a2\fermata
  fis g8 [e]
  b [a] gis2.\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 e4
  fis8 [e] d [cis] b,4 ais,
  b, fis b,\fermata dis
  e fis g e
  a, b, e\fermata }
  r e8 [d] c [b,] a, [b,]
  c [d] e4 fis g\fermata
  g e fis g
  d8 [e] fis4 fis, b,\fermata
  e fis g b,8 [c]
  d4 e fis8 [gis] a2\fermata
  dis4. b,8 e [a,]
  b,4 e2.\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Hier ist das rech -- te O -- ster -- lamm,
  da -- von Gott hat ge -- bo -- ten,
  des Blut zeich -- net uns -- re Tür,
  das hält der Glaub dem To -- de für;
  der Wür -- ger kann uns nicht rüh -- ren.
  Al -- _ le -- lu -- ja!
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  das ist hoch an des Kreu zes Stamm
  in hei -- ßer Lieb ge -- bra -- ten,
}

