sopranoMusic = \relative c' {
          \partial 4 d'4
          bes g a\fermata fis
          g g fis\fermata d'
          d d es d
          c2 bes \fermata
          a4 bes c d
          c bes a2\fermata
          g4 a bes c
          a2 g4\fermata \fine 
        }

altoMusic = \relative c' {
          \partial 4 fis4
          d es a,\fermata d
          d cis d\fermata fis
          g a g d
          g f d2\fermata
          d4 d f f
          fis g fis2\fermata
          g4 fis g g
          e d b4\fermata \fine
        }

tenorMusic = \relative c {
          \partial 4 a'4
          bes c fis,\fermata a
          g e d\fermata a'
          bes d bes bes
          bes a bes2\fermata
          fis4 g a bes
          c d d2\fermata
          d4 c d g,
          g fis g\fermata
          \fine
        }

bassMusic = \relative c {
          \partial 4 d4
          g es d\fermata d
          es a, d\fermata d
          g fis g f
          es f bes,2\fermata
          d4 g f bes
          a g d2\fermata
          bes'4 a g es
          c d g,\fermata \fine
        }

sopranoLyrics = \lyricmode {
      O Trau -- rig -- keit,
      O Her -- ze -- leid!
      Ist das nicht zu be -- kla -- gen?
      Gott des Va -- ters ei -- nigs Kind
      wird ins Grab ge -- tra -- gen.
     }

altoLyrics = \lyricmode {
      O Trau "rig keit," O Her -- ze -- leid! Ist das nicht zu be - kla - gen? Gott des Va -- ters ei -- nigs Kind wird ins Grab ge - tra
    }

tenorLyrics = \lyricmode {
      O Trau -- rig -- keit, O Her -- ze -- leid! Ist das nicht zu be - kla - gen? Gott des Va -- ters ei -- nigs Kind wird ins Grab ge - tra
    }

