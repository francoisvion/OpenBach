  a4 a, d\fermata r
  r d d' cis'
  b4. a8 g fis g e
  fis4 g8 fis e4 fis
  b,2\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Al -- lein zu dir, Herr Je -- _ su Christ,
  mein Hoff -- nung steht auf Er -- _ _ _ _ _ _ den.
  Von An -- be -- ginn ist nichts er -- korn,
  auf Er -- den ist kein Mensch ge -- born,
  der mir aus Nö -- ten hel -- fen kann; ich ruf dich an, __
  zu dem ich mein Ver -- trau -- en han. __ _ _ _
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Ich weiß, dass du mein Trö -- _ ster bist,
  kein Trost mag mir sonst wer -- _ _ _ _ _ _ den.
}

