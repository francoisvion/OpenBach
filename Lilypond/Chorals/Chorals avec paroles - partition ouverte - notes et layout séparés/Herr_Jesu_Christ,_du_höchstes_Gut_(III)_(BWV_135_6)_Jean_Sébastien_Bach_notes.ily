sopranoMusic = {
\repeat volta 2 {
  \partial 4 e'4
  a' g' f' e'
  d'2 e'4\fermata b'
  c'' c'' b' b'
  a'2.\fermata }
  c''4 b'8 [a'] g'4 a'
  b' c''2 c''4\fermata
  g' a' g' f'
  f' e'2.\fermata
  c''4 b'8 [c''] d''4 c''
  b' a'2 b'4\fermata
  e' f' e' d'
  g' e'2.\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 c'8 [d']
  e' [f'] e' [d'] c' [d'] e'4
  a2 b4\fermata e'
  e' a' a' gis'
  e'2.\fermata }
  a'8 [g'] f'4 e'8 [d'] c'4
  f' f' e'8 [d'] e'4\fermata
  e' f' e' e'
  d' cis'2.\fermata
  e'4 d' g' g'8 [d']
  d' [g'] g'4 fis' g'\fermata
  e'8 [d'] c'4 c' f'8 [e']
  d'4~ d'8 [b] c'4 b\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 a4
  a8 [c'] b4 a b8 [c']
  d' [c' b a] gis4\fermata b
  a4. e'8 f' [d'] e' [b]
  c'2.\fermata }
  e'4 d'8 [c'] b4 a
  d' g2 g4\fermata
  c' c' bes a
  a a2.\fermata
  g8 [a] b4 b b8 [a]
  b [c'16 d'] e'4 d' d'\fermata
  b a g a
  b~ b8 [gis] a4 gis\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 a,8 [b,]
  c [d] e4 a g
  f2 e4\fermata gis
  a8 [e] f [c] d [b,] e4
  a,2.\fermata }
  a4 d e f8 [e]
  d4 c2 c4\fermata
  c f8 [e] d [cis] d [e]
  f [g] a2.\fermata
  e8 [fis] g [a] b [g] e [fis]
  g [e] c [a,] d4 g,\fermata
  gis, a,8 [b,] c2
  b,4 c b,8 [a,] e4\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Ehr sei ins Him -- mels Thro -- ne
  mit ho -- hem Ruhm und Preis
  dem Heil -- gen Geist mit Eh -- ren
  in al -- le E -- wig -- keit,
  der woll uns all'n be -- sche -- ren
  die ew -- ge Se -- lig -- keit.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  dem Va -- ter und dem Soh -- ne
  und auch zu glei -- cher Weis
}

