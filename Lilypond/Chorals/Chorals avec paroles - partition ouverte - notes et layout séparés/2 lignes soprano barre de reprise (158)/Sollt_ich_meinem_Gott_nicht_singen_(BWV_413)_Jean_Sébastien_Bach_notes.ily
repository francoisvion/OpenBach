bassMusic = {
  \repeat volta 2 {
    d4 d, d
    d8 [cis] d [e] f [g]
    a4 g a
    d2 d,4\fermata
    d8 [e] f [g] a [a,]
    bes, [c] d [e] f [f,]
    bes, [a,] g,4 c
    f,2.\fermata }
  d4 d' c'8 [bes]
  a [a,] bes, [c] d [c]
  d [e] f [g] a [bes]
  c'2 c4\fermata
  c' bes8 [a] g [fis]
  g [f] ees [d] ees [d]
  c [bes,] c4 d
  g,2.\fermata
  d8 [cis] d [e] f [d]
  e [c] d [e] f [e]
  d [e] f [g] a [bes]
  c'2.\fermata
