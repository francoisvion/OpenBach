sopranoMusic = {
\repeat volta 2 {
  \partial 4 e'8 [fis']
  g'4 a' b' a'
  d'' cis'' b'\fermata a'
  d'' cis'' b' a'
  g' fis' e'\fermata }
  e' a' a'8 [g'] fis'4
  b' b' ais' b'\fermata
  b' e'' e'' fis''8 [e'']
  d''4 e''8 [d''] cis''4 b'\fermata
  cis'' d'' cis'' b'
  a' b'8 [a'] g'4 fis'\fermata
  e'8 [fis'] g'4 a' b'
  a'8 [g'] a' [g'] fis'4 e'\fermata
  e'' e'' e'' fis''
  e'' d'' cis'' b'\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  \partial 4 b4
  e' fis' g' fis'
  b'4. ais'8 fis'4\fermata fis'
  fis'8 [g'] g' [fis'] fis' [e'] e' [dis']
  e'4 dis' b\fermata }
  b e'8 [d'] e' [cis'] d'4
  d' cis' cis' dis'\fermata
  e' e'8 [fis'] g'4 fis'
  b'8 [a'] g' [fis'] e'4 d'\fermata
  fis' fis' e' d'8 [e']
  fis'4 fis' e' dis'\fermata
  b e' e'8 [fis'] g'4
  fis' e' dis' b\fermata
  gis' a' a' a'
  g'8 [fis'] b'4 ais' fis'\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  \partial 4 g8 [a]
  b4 d' d' d'8 [e']
  fis' [d'] g' [fis'] d'4\fermata cis'
  b cis' dis'8 [e'] fis'4
  b4. a8 g4\fermata }
  g a a a
  g g fis fis\fermata
  g8 [a] b4 cis' cis'
  b b4. ais8 fis4\fermata
  ais b8 [a] g [a] b [cis']
  d' [c'] b4 b b\fermata
  g g c' d'
  cis'8 [dis'] e'4 b g\fermata
  b cis' cis' d'8 [cis']
  b [ais] b4 fis'8 [e'] dis'4\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  \partial 4 e4
  e d g d8 [cis]
  b, [g] e [fis] b,4\fermata fis
  b a g fis
  e b, e,\fermata }
  e8 [d] cis [b,] cis [a,] d4
  g8 [fis] e4 fis b,\fermata
  e8 [fis] g4 a d
  g8 [fis] e4 fis b,\fermata
  fis b e8 [fis] g4
  fis8 [e] dis4 e b,\fermata
  e8 [d] c [b,] a,4 g,
  a,8 [b,] c [a,] b,4 e\fermata
  e a8 [g] fis [e] d4
  e8 [fis] g [e] fis4 b,\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Das Aug al -- lein das Was -- ser sieht,
  wie Men -- schen Was -- ser gie -- _ ßen,
  Und ist für ihm ein ro -- te Flut
  von Chris -- ti Blut ge -- fär -- _ bet,
  die al -- len Scha -- den hei -- let gut
  von A -- dam her ge -- er -- _ bet,
  auch von uns selbst be -- gan -- _ gen.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Der Glaub al -- lein die Kraft ver -- steht
  des Blu -- tes Je -- su Chris -- _ ti,
}

