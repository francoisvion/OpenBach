sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  b'4
          g' a'8 [b'16 c''] b'4. a'8
          g'4 fis'8 [g'16 a'] g'4. fis'8
          e'2\fermata c''4 b'
          e'' d'' fis'8 [c''] b' [a']
          a'2 g'4\fermata }
          \partial 4  b'
          a' b'8 [g'] a'4 b'8 [c'']
          d''4 c''8 [b'] c'' [b'] a'4\fermata
          r c'' fis' e''8 [dis'']
           e'' [d''] c'' [b'] a' [g''] fis'' [e'']
          dis'' [cis''] b'4\fermata r e''
          c'' b'8 [a'] b' [dis'] e' a'
          g'4 fis'8 [e'] e'4\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  e'4
          e' fis'8 [g'16 a'] g'8 [dis'] e' [fis']
          fis' [e'] e' [dis'] e'4. dis'8
          e'2 g'4. fis'8
          e' [fis'] fis' [g'] fis'4 g'
          g' fis' d' }
          \partial 4  g'
          a'8 [fis'] g' [e'] fis'4 e'
          d' e' e'8 [d'] e'4
          r e' dis'8 [e'] fis'4
          e'8 [fis'] g' [f'] e'4 a'8 [b'16 c'']
          fis'8 [e'] dis'4 r e'
          e'4. fis'8 dis' [fis'] e' e'
          e'4 dis' b \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          \partial 4  g4
          b c'8 [a] g [a] b [c']
          b4 b b8 [g] a4
          g2 g8 [a] b4
          b8 [a] a [b] c'4 d'
          e' d'8 [c'] b4 }
          \partial 4  d'
          d' d'8 [cis'] d'4 gis8 [a]
          a [b] gis4 a8 [b] c'4
          r c' b4. c'8
          b [a] g [gis] a [b] c'4
          b fis r b
          a8 [b] c'4 fis8 [a] b a
          b4 a8 [g] g4 \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          \partial 4  e4
          e8 [dis] e [dis] e [fis] g [a]
          b4 b, e2
          e\fermata e4. d8
          c c'4 b8 a4 g
          c d g,\fermata }
          \partial 4  g
          fis8 [d] g4 d8 [e] d [c]
          b,4 e a a,\fermata
          r a b8 [c'] b [a]
          g [fis] e [d] c [b,] a,4
          b, b,\fermata r gis
          a8 [a,] a4~ a8 [fis] g c
          b, [a,] b,4 e\fermata \fine
        }

sopranoLyrics = \lyricmode {
      Gieb dich zu -- frie -- den und sei stil - le in dem Got -- te dei -- nes Le -- bens,
      Er ist dein Quell und dei -- ne Son -- ne, scheint täg -- lich hell zu dei -- ner Won -- ne, gib dich zu -- frie -- den, zu frie - den.
    }

sopranoLyrics2 = \lyricmode {
      in ihm ruht al -- ler Freu -- den Fül - le ohn ihn mühst du dich ver -- ge -- bens.
    }
