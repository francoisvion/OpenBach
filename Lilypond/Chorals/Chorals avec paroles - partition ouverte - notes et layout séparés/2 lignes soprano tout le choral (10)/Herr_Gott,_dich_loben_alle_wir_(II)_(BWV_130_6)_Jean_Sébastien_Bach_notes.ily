sopranoMusic = {
  \repeat volta 2 {
  \partial 4 c''4
  c''2 b'4 a'2
  g'4 c''2
  d''4 e''2\fermata e''4
  e''2 e''4 d''2
  c''4 f''2
  e''4 d''2\fermata c''4
  d''2 e''4 d''2
  c''4 a' b'2
  c''\fermata g''4
  e''4. d''8 c''4 d''4.
  e''8 f''4 e'' d''2
  c''\fermata r4 \fine
}}

altoMusic = {
  \repeat volta 2 {
  \partial 4 g'4
  g'2 g'8 [f'] e'4.
  f'8 g'4 e' c''
  b' g'2\fermata g'4
  g'2 g'4 f'
  e' e' a' g'8 [f']
  c''4 b'2\fermata e'8 [fis']
  g'2 g'4 gis'2
  a'4 a' g'8 [f']
  g'4 g'2\fermata g'4
  g'4. f'8 g'4 a'
  g' c'' c'' b'8 [a']
  g'4 g'2\fermata r4 \fine
}}

tenorMusic = {
  \repeat volta 2 {
  \partial 4 e'4
  e'2 d'4 c'2
  c'4 c' g
  g' e'2\fermata c'4
  c'2 b8 [a] b2
  c'4 c'4. b8
  g'4 g'2\fermata c'4
  b2 c'4 b2
  c'4 c' b8 [c']
  d'4 e'2\fermata d'4
  c' g c' c'
  b a g g'4.
  f'8 e'2\fermata r4 \fine
}}

bassMusic = {
  \repeat volta 2 {
  \partial 4 c4
  c8 [d e f] g4 a,8 [b, c d]
  e4 a e
  g c2\fermata c4
  c8 [d e f] g4 gis8 [fis gis e]
  a [g] f4 e8 [d]
  c4 g2\fermata a4
  g8 [f e d] c [d] e [d c b,]
  a,4 f d
  g c2\fermata b,4
  c8 [b, c d] e [c] f [e f g]
  a [b] c'4 g2
  c\fermata r4 \fine
}}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Da -- rum wir bil -- lig lo -- ben dich
  und dan -- ken dir, Gott e -- wi -- glich,
  wie auch der lie -- ben En -- gel Schar
  dich prei -- _ sen heut __ _ und im -- mer -- dar.
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Und bit -- ten dich, wollst al -- le -- zeit
  die -- sel -- ben hei -- ßen sein be -- reit,
  zu schü -- tzen dei -- ne klei -- ne Herd,
  so hält __ _ dein gött -- _ lichs Wort in Wert.
}

altoLyricsOne = \lyricmode {\set stanza = 1
