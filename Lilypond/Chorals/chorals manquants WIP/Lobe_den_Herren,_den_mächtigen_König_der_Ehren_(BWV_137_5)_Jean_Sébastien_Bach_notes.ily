sopranoMusic = {
\repeat volta 2 {
  c''4 c'' g'' e''4.
  d''8 c''4 b'4. a'8
  g'4 c'' d'' e''8 [f'']
  d''2 c''4\fermata }
  e''4. d''8 e''4 f''2.\fermata
  e''4. f''8
  g''4 g''4. f''8 e''4
  d''2.\fermata g'4
  a' b' c'' d''
  e''8. [f''16] d''2 c''4\fermata \fine
}

altoMusic = {
\repeat volta 2 {
  g'4 g' g' g'4.
  g'8 fis'4 d' g'
  g' g' b' g'
  g' f' e'\fermata }
  g'4. g'8 cis'4 a'2.\fermata
  a'4. a'8
  d'4 c' g' g'
  g'2.\fermata d'4
  d' d' g' g'
  g' g'2 e'4\fermata \fine
}

tenorMusic = {
\repeat volta 2 {
  e'4 e' d' c'4.
  g8 c'4 g' g
  d' c' f c'
  d' b g\fermata }
  e'4. e'8 e' [cis'] d'2.\fermata
  e'4. c'8
  b [a] g4 b c'
  b2.\fermata b4
  d' g g g
  g8 [c'] c'4 b g\fermata \fine
}

bassMusic = {
\repeat volta 2 {
  c4 c' b c'4.
  b8 a4 g g,
  f e d c
  g g, c\fermata }
  c e a d2.\fermata
  a4 g
  f e4. d8 c4
  g,2.\fermata g4
  f8 [e] f [d] e4 b,
  c g g, c\fermata \fine
}

sopranoLyricsOne = \lyricmode {\set stanza = 1
  Lo -- be den Her -- ren, was in mir ist, lo -- be den Na -- men!
  Er ist dein Licht,
  See -- le, ver -- giss es ja nicht;
  Lo -- ben -- de, schlie -- ße mit A -- men!
}

sopranoLyricsTwo = \lyricmode {\set stanza = 2
  Al -- les, was O -- dem hat, lo -- be mit A -- bra -- hams Sa -- men!
}

