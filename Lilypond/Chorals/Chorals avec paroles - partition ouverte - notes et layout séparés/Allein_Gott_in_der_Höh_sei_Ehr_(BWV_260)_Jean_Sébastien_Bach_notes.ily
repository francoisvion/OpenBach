sopranoMusic = {
  \repeat volta 2 {
    \partial4 g'8 [a']
    b'4 c'' d''  c''
    b' a' b'\fermata b'
    b'4 a'8 [b'] c'' [b'] a'4
    g'8 [e'] fis'4 g'\fermata } g'4
    a' b' c'' b'
    a'8. [b'16] b'4\trill a'\fermata a'
    b' c'' d'' c''
    b' a' b'\fermata g'
    a' b' c''8 [b'] a'4
    g'8 [e'] fis'4 g'\fermata \fine
}

altoMusic = {
  \repeat volta 2 {
    \partial4 d'4
    g' g' fis' e'8 [fis']
    g' [fis'] e'4 dis'\fermata e'
    d'8 [e'] fis'4 g'4. fis'8
    g'4 d' d'\fermata } d'8 [e']
    fis'4 gis' a'8 [a] d' [e']
    a8 a'4 gis'8 e'4\fermata d'
    d' g' fis'8 [gis'] a'4
    g'8 [fis'] e'4 dis'\fermata b8 [cis']
    d' [e'] fis'4 e'4. d'16 [c']
    g'4 d' d'\fermata \fine
}

tenorMusic = {
  \repeat volta 2 {
    \partial4 b8 [c']
    d'4 e'8 [g] a [b] c' [d']
    e' [b] c'4 fis\fermata g8 [a]
    b8 [c'] d'4 e'4. d'16 [c']
    d'8 [c'16 b] a4 b\fermata } b4
    a d' e'8 [f'] f' [e']
    e'16 [d' e'8] f' [e'16 d'] c'4\fermata a
    g g8 [a] b4 e
    e'8 [b] c'4 fis\fermata g
    fis b8 [a] g4. fis8
    d' [c'16 b] a4 b\fermata \fine
}

bassMusic = {
  \repeat volta 2 {
    \partial 4 \break g,4
    g8 [fis] e4 d a,
    e8 [d] c4 b,\fermata e8 [fis]
    g4 fis e8 [d] c [a,]
    b,8 [c] d4 g,\fermata } g4
    d8 [d'] c' [b] a4 g
    f8 [c] d [e] a,4\fermata fis
    g8 [fis] e4 b, c8 [d]
    e [d] c4 b,\fermata e
    d dis e8 [d] c [a,]
    b, [c] d4 g,\fermata \fine
}

sopranoLyricsOne = \lyricmode {
   Al -- lein Gott in der Höh' sei Ehr'
   und Dank für sei -- ne Gna -- _ de,
   Ein Wohl -- ge -- fall'n Gott an uns hat,
   nun ist gross Fried' ohn' Un -- ter -- lass,
   all' Fehd' hat nun ein En -- _ de.
}

sopranoLyricsTwo = \lyricmode {
    da -- rum dass nun und nim -- mer -- mehr
    uns rüh -- ren kann kein Scha -- _ de.
    }

