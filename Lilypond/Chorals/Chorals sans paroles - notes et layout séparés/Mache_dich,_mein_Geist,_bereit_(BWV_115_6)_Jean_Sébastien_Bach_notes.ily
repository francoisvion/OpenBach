sopranoMusic = {
          \voiceOne
          \repeat volta 2 {
          b'4 c'' d'' d''
          g' a' b'2\fermata
          e''4 fis'' g'' b'
          a'2 g'\fermata }
          d''4 a' b'2\fermata
          e''4. d''8 cis''2\fermata
          d''4 a' b'8 cis'' d''4
          d'' cis'' d''2\fermata
          e''4 fis'' g'' b'
          a'2 g'\fermata \fine
        }

altoMusic = {
          \voiceTwo
          \repeat volta 2 {
          g'4 g' a'8 g' fis'4
          g' g'8 fis' g'2\fermata
          g'4 a' g'8 fis' g'4
          g' fis' d'2\fermata }
          a'8 g' fis' a' g'2\fermata
          e'4 e' e'2\fermata
          a'4 a'4. g'8 fis'4
          e'2 fis'\fermata
          a'4 a' g' g'
          g' fis' d'2\fermata \fine
        }

tenorMusic = {
          \voiceOne
          \repeat volta 2 {
          d'4 e' a b
          b e'8 d' d'2\fermata
          c'4 c' d' d'
          e' d'8 c' b2\fermata }
          d'4 d' d'2\fermata
          b8 a gis b a2\fermata
          d'8 e' fis'4 fis'8 e' d' cis'
          b4 a a2\fermata
          c'4 d' d' d'
          e' d'8 c' b2\fermata \fine
        }

bassMusic = {
          \voiceTwo
          \repeat volta 2 {
          g8 fis e g fis e d fis
          e d c d g,2\fermata
          c8 b, a, c b, a, g, b,
          c a, d4 g,2\fermata }
          fis8 e d fis g2\fermata
          gis8 fis e gis a2\fermata
          fis8 e d fis g a b a
          g e a4 d2\fermata
          a,8 b, c a, b, c d b,
          c a, d4 g,2\fermata \fine
        }
