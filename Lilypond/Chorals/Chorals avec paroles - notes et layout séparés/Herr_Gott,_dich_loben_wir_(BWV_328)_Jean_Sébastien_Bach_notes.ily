bassMusic = {
          \voiceTwo
          \partial 4  e,4
          e d c d
          a,2\fermata r4 a
          e8 [fis] g4 c d
          g,2.\fermata
          \repeat volta 2 {
          \partial 4  e4
          a d8 [e16 fis] g4. fis8
          g [e] a4 d\fermata cis
          d e f8 [e] d4
          c d g,\fermata }
          \repeat volta 2 {
          \partial 4 c
          b, a,8 [f] d [b,] e4
          a,2.\fermata }
          \repeat volta 2 {
          \partial 4  e8 [fis]
          g [fis] e4 b, cis
          d g f8 [e] d4
          c d g,\fermata }
          \repeat volta 2 {
          \partial 4 e8 [d]
          c [d] e [fis] g4 d
          g, a, d,\fermata d8 [e]
          f4 e d g8 [f]
          e [c] d4 g,\fermata }
          \repeat volta 2 {
          \partial 4  d
          cis d e4. fis8
          g4 cis d\fermata f
          a,8 [bes,] c4 f,8 [g,] a, [b,]
          c4 g, c\fermata }
          \partial 4 f,
          g, a,8 [b,] c4 b,
          a, d g,\fermata g8 [f]
          e [d] c4 f8 [g16 a] bes4~
           bes8 [cis] d4 a,\fermata a,
          b, a,8 [b,] c4 g,
          f, g, c\fermata c8 [d]
          e4 c f, bes,8 [a,]
          g,4 d a,\fermata d8 [c]
          b, [a,] g,4 c g,
          a,8 [f,] g,4 c,\fermata c8 [d]
          e [f] g4 f8 [e] d4
          d8 [cis] d4 a,\fermata a
           e8 [d] c4 f8 [e] d4
          a8 [g] f [d] a4\fermata a,8 [b,]
          c [d] e4. d8 e [f]
          g [f] g [g,] c4\fermata
          \repeat volta 2 {
          \partial 4 a,
          d c8 [d] e [f] g [f]
          e [d] cis4 d\fermata f8 [e]
          d4 e f a,8 [b,]
          c4 g, a,\fermata }
          \partial 4  d
          d8 [c] bes, [a,] g,4 f,
          e, d, a,\fermata d8 [c]
          bes, [a,] g,4 f,8 [g,16 a,] bes,4
          b,8 [g,] d4 a,\fermata b,
          c2. b,8 [a,]
          gis,4. e,8 a, [b,] c [d]
