}

bassMusic = {
\repeat volta 2 {
  \partial 4 d8 e
  fis4 g fis4. gis8
  ais4 b8 a gis4 a
  d2\fermata r4 d'
  a b e fis~
  fis e8 d cis b, ais, cis
  fis4 g8 fis e4 fis
  b,2\fermata }
