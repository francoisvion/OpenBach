sopranoLyrics = \lyricmode {
  Schaut hin, dort liegt im fin -- stern Stall,
  des Herr -- schaft ge -- het ü -- ber -- all!
  Da Spei -- se vor -- mals sucht ein Rind, __ _
  Da ru -- het jetzt der Jung -- frau -- 's __ _ Kind.
}

